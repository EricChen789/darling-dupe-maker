# ─── Full Export ───

@app.route('/api/export-all', methods=['POST'])
def export_all():
    """Export all tables as a JSON dump. Returns JSON (zip requires extra deps)."""
    try:
        db = get_db()
        export = {}
        for table in TABLES:
            try:
                rows = db.execute(f"SELECT * FROM {table}").fetchall()
                export[table] = [dict(r) for r in rows]
            except sqlite3.OperationalError:
                export[table] = []
        return jsonify({'success': True, 'data': export, 'exported_at': datetime.now().isoformat()})
    except Exception as e:
        import traceback
        traceback.print_exc()
        return jsonify({'error': str(e)}), 500


# ═══ Form History ═══

@app.route('/api/form-history/list', methods=['GET'])
def form_history_list():
    """List saved form submissions for the current user and form type."""
    try:
        user = get_user()
        if not user:
            return jsonify({'error': 'Not authenticated'}), 401
        form_type = request.args.get('formType', '')
        if not form_type:
            return jsonify({'error': 'formType required'}), 400
        db = sqlite3.connect(DB_PATH)
        rows = db.execute(
            "SELECT id, label, form_type, submission_index, created_at FROM form_history "
            "WHERE user_id=? AND form_type=? ORDER BY submission_index DESC",
            (user['id'], form_type)
        ).fetchall()
        db.close()
        entries = [{'id': r[0], 'label': r[1], 'form_type': r[2],
                     'submission_index': r[3], 'created_at': r[4]} for r in rows]
        return jsonify({'entries': entries})
    except Exception as e:
        return jsonify({'error': str(e)}), 500


@app.route('/api/form-history/load', methods=['GET'])
def form_history_load():
    """Load a saved form submission by ID."""
    try:
        user = get_user()
        if not user:
            return jsonify({'error': 'Not authenticated'}), 401
        entry_id = request.args.get('id', '')
        if not entry_id:
            return jsonify({'error': 'id required'}), 400
        db = sqlite3.connect(DB_PATH)
        row = db.execute(
            "SELECT id, form_data FROM form_history WHERE id=? AND user_id=?",
            (entry_id, user['id'])
        ).fetchone()
        db.close()
        if not row:
            return jsonify({'error': 'Not found'}), 404
        import json
        return jsonify({'entry': {'id': row[0], 'form_data': json.loads(row[1])}})
    except Exception as e:
        return jsonify({'error': str(e)}), 500


@app.route('/api/form-history/save', methods=['POST'])
def form_history_save():
    """Save current form data for later reuse."""
    try:
        user = get_user()
        if not user:
            return jsonify({'error': 'Not authenticated'}), 401
        data = request.json
        if not data:
            return jsonify({'error': 'Empty request body'}), 400
        form_type = data.get('formType', '')
        form_data = data.get('formData')
        if not form_type or form_data is None:
            return jsonify({'error': 'formType and formData required'}), 400

        db = sqlite3.connect(DB_PATH)
        # Get next submission index
        max_idx = db.execute(
            "SELECT COALESCE(MAX(submission_index), 0) FROM form_history WHERE user_id=? AND form_type=?",
            (user['id'], form_type)
        ).fetchone()[0]
        next_idx = max_idx + 1

        # Generate label: YYYY-MM-DD_FORM_N
        from datetime import date
        today = date.today().isoformat()
        label = f"{today}_{form_type}_{next_idx}"

        import json
        cur = db.execute(
            "INSERT INTO form_history (user_id, user_email, form_type, submission_index, label, form_data) "
            "VALUES (?, ?, ?, ?, ?, ?)",
            (user['id'], user['email'], form_type, next_idx, label, json.dumps(form_data, ensure_ascii=False))
        )
        db.commit()
        entry_id = cur.lastrowid
        db.close()
        return jsonify({'id': entry_id, 'label': label, 'submission_index': next_idx})
    except Exception as e:
        return jsonify({'error': str(e)}), 500


@app.route('/api/form-history/<entry_id>', methods=['DELETE'])
def form_history_delete(entry_id):
    """Delete a saved form submission and renumber remaining records."""
    try:
        user = get_user()
        if not user:
            return jsonify({'error': 'Not authenticated'}), 401
        db = sqlite3.connect(DB_PATH)

        # Get the record being deleted so we know its form_type and submission_index
        row = db.execute(
            "SELECT form_type, submission_index FROM form_history WHERE id=? AND user_id=?",
            (entry_id, user['id'])
        ).fetchone()
        if not row:
            db.close()
            return jsonify({'error': 'Not found'}), 404

        form_type, deleted_idx = row[0], row[1]

        # Delete the record
        db.execute("DELETE FROM form_history WHERE id=? AND user_id=?", (entry_id, user['id']))

        # Renumber: shift down all later submissions by 1
        db.execute(
            "UPDATE form_history SET submission_index = submission_index - 1 "
            "WHERE user_id=? AND form_type=? AND submission_index > ?",
            (user['id'], form_type, deleted_idx)
        )

        # Update labels to match new indices: "YYYY-MM-DD_FORM_TYPE_n"
        rows = db.execute(
            "SELECT id, created_at, submission_index FROM form_history "
            "WHERE user_id=? AND form_type=? AND submission_index >= ? "
            "ORDER BY submission_index",
            (user['id'], form_type, deleted_idx)
        ).fetchall()
        import re as _re
        for rid, created_at, new_idx in rows:
            date_part = (created_at or '')[:10]  # YYYY-MM-DD
            new_label = f"{date_part}_{form_type}_{new_idx}"
            # Also update the embedded label inside form_data JSON if it references the old index
            db.execute("UPDATE form_history SET label=? WHERE id=?", (new_label, rid))

        db.commit()
        db.close()
        return jsonify({'success': True})
    except Exception as e:
        return jsonify({'error': str(e)}), 500



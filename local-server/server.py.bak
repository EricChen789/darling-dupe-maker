                "INSERT INTO email_logs (id, company_id, template_id, to_email, subject, body, status, scheduled_at, email_type) "
                "VALUES (?, ?, ?, ?, ?, ?, 'scheduled', ?, 'reminder')",
                (str(uuid.uuid4()), cid, templates['reminder'], 'client@example.com',

@app.route('/api/generate-scr-pdf', methods=['POST'])
def generate_scr_pdf():
    data = request.get_json(silent=True) or {}
    company_id = data.get('companyId', '')
    if not company_id:
        return jsonify({'error': 'companyId required'}), 400

    db = get_db()
    company = db.execute("SELECT * FROM companies WHERE id = ?", (company_id,)).fetchone()
    if not company:
        return jsonify({'error': 'Company not found'}), 404

    scrs = db.execute(
        "SELECT * FROM significant_controllers WHERE company_id = ? ORDER BY created_at",
        (company_id,)).fetchall()

    pdf = create_pdf()
    pdf.add_page()
    pdf.set_auto_page_break(auto=False)
    y = pdf_draw_page_header(pdf, "重要控制人登記冊 / Significant Controllers Register", company)

    scr_cols = [
        ("#", MARGIN + 1, 18),
        ("姓名/名稱 Name", MARGIN + 20, 90),
        ("身份 Identity", MARGIN + 111, 48),
        ("證件/公司編號 ID/Reg No", MARGIN + 160, 65),
        ("地址 Address", MARGIN + 226, 110),
        ("控制性質 Nature of Control", MARGIN + 337, 90),
        ("成為日期 Date Became", MARGIN + 428, 48),
        ("停止日期 Date Ceased", MARGIN + 477, 48),
    ]
    y = pdf_draw_table_header(pdf, scr_cols, y)
    row_num = 0

    if not scrs:
        pdf_draw(pdf, "(無記錄 / None)", MARGIN + 5, y + 18, size=9, gray=128)
    else:
        for s in scrs:
            natures = []
            if rget(s, 'nature_shares'): natures.append('持股>25%')
            if rget(s, 'nature_voting'): natures.append('表決權>25%')
            if rget(s, 'nature_appoint'): natures.append('任命董事')
            if rget(s, 'nature_influence'): natures.append('重大影響')
            if rget(s, 'nature_trust'): natures.append('信託控制')
            if rget(s, 'nature_other'): natures.append(s['nature_other'])

            is_nat = rget(s, 'identity') != 'corporate'
            id_info = rget(s, 'id_number') or rget(s, 'passport_number') or '-' if is_nat else rget(s, 'company_number_ref') or '-'
            row_num += 1
            values = [
                str(row_num),
                rget(s, 'name_english') or rget(s, 'name_chinese') or '(unnamed)',
                '自然人' if is_nat else '法人',
                id_info,
                (rget(s, 'address') or '')[:50],
                '、'.join(natures) or '-',
                rget(s, 'date_became') or '-',
                rget(s, 'date_ceased') or "現任",
            ]
            if y + 40 > PAGE_H - 60:
                pdf.add_page()
                y = pdf_draw_page_header(pdf, "重要控制人登記冊 / SCR (續)", company)
                y = pdf_draw_table_header(pdf, scr_cols, y)
            y = pdf_draw_table_row(pdf, scr_cols, values, y, alt=(row_num % 2 == 0))

            # Designated rep info
            if rget(s, 'is_designated_rep') and rget(s, 'designated_rep_name'):
                y += 2
                if y > PAGE_H - 60:
                    pdf.add_page()
                    y = pdf_draw_page_header(pdf, "重要控制人登記冊 / SCR (續)", company)
                pdf_draw(pdf, f"  → 指定代表: {rget(s, 'designated_rep_name') or '-'}  |  聯絡: {rget(s, 'designated_rep_contact') or '-'}",
                          MARGIN + 20, y, size=7.5, gray=80)
                y += 14

    pdf_bytes = bytes(pdf.output())
    import base64 as b64
    return jsonify({'pdf': b64.b64encode(pdf_bytes).decode('ascii')})

# ─── 股權轉讓文件 PDF ───
@app.route('/api/generate-share-transfer-pdf', methods=['POST'])
def generate_share_transfer_pdf():
    data = request.get_json(silent=True) or {}
    company_id = data.get('companyId', '')
    transaction_id = data.get('transactionId', '')
    doc_type = data.get('documentType', 'instrument_of_transfer')

    if not company_id:
        return jsonify({'error': 'companyId required'}), 400

    db = get_db()
    company = db.execute("SELECT * FROM companies WHERE id = ?", (company_id,)).fetchone()
    if not company:
        return jsonify({'error': 'Company not found'}), 404

    # Fetch transaction(s)
    transaction = None
    all_txs = []
    if transaction_id:
        transaction = db.execute(
            "SELECT * FROM share_transactions WHERE id = ? AND company_id = ?",
            (transaction_id, company_id)).fetchone()
    all_txs_result = db.execute(
        "SELECT * FROM share_transactions WHERE company_id = ? ORDER BY transaction_date DESC",
        (company_id,)).fetchall()
    all_txs = all_txs_result

    shareholders = db.execute(
        "SELECT * FROM person_company_roles WHERE company_id = ? AND role = 'shareholder'",
        (company_id,)).fetchall()

    pdf = create_pdf()
    pdf.set_auto_page_break(auto=False)

    def draw_label(pdf, x, y, label, val, size=10):
        pdf_draw(pdf, label, x, y, size=size, gray=80)
        pdf_draw(pdf, str(val or '__________________________'), x + 140, y, size=size)

    def draw_line_h(pdf, x1, x2, y, gray=200):
        pdf.set_draw_color(gray, gray, gray)
        pdf.line(x1, y, x2, y)

    if doc_type == 'share_certificate':
        # ── Share Certificate ──
        pdf.add_page()
        # Ornate border
        pdf.set_draw_color(25, 75, 25)
        pdf.rect(15, 15, PAGE_W - 30, PAGE_H - 30, style='D')
        pdf.set_draw_color(50, 127, 50)
        pdf.rect(22, 22, PAGE_W - 44, PAGE_H - 44, style='D')

        y = PAGE_H - 70
        pdf_draw(pdf, "股票證書 / SHARE CERTIFICATE", PAGE_W / 2 - 120, y, size=16)
        y -= 28
        pdf.set_draw_color(25, 75, 25)
        pdf.line(80, y, PAGE_W - 80, y)
        y -= 24

        tx = transaction or (all_txs[0] if all_txs else {})
        draw_label(pdf, 50, y, "公司名稱:", company['name'] or '')
        y -= 18
        if company.get('chinese_name'):
            draw_label(pdf, 50, y, "中文名稱:", company['chinese_name'])
            y -= 18
        draw_label(pdf, 50, y, "商業登記號碼:", company.get('company_number', ''))
        y -= 18
        draw_label(pdf, 50, y, "註冊辦事處地址:", company.get('address') or company.get('registered_office') or '')
        y -= 30
        pdf_draw(pdf, "茲證明 / THIS IS TO CERTIFY that", 50, y, size=10, gray=80)
        y -= 24
        pdf_draw(pdf, rget(tx, 'to_name') or '________________________________', PAGE_W / 2 - 80, y, size=13)
        y -= 22
        pdf_draw(pdf, "is/are the registered holder(s) of", 50, y, size=10, gray=80)
        y -= 22
        shares = str(tx.get('shares', '________')) if tx else '________'
        share_cls = rget(tx, 'share_type') or 'Ordinary'
        pdf_draw(pdf, f"{shares} {share_cls} Share(s)", PAGE_W / 2 - 60, y, size=13)
        y -= 22
        pdf_draw(pdf, f"of HK$ {rget(tx, 'price_per_share') or '____'} each fully paid", 50, y, size=10, gray=80)
        y -= 22
        pdf_draw(pdf, "in the above-named Company", 50, y, size=10, gray=80)
        y -= 30
        pdf_draw(pdf, f"證書編號 Certificate No: {rget(tx, 'instrument_number') or '______________'}", 50, y, size=9, gray=100)
        y -= 50
        # Signatures
        pdf.line(50, y, 200, y)
        pdf.line(PAGE_W - 200, y, PAGE_W - 50, y)
        y -= 14
        pdf_draw(pdf, "董事 Director", 50, y, size=8, gray=100)
        pdf_draw(pdf, "公司秘書 Secretary", PAGE_W - 200, y, size=8, gray=100)
        y -= 24
        pdf_draw(pdf, f"簽發日期 Issue Date: {rget(tx, 'transaction_date') or '________________'}", 50, y, size=9)
        pdf_draw(pdf, f"由 Muse Labs 秘書系統生成 | {datetime.now().strftime('%Y-%m-%d')}", PAGE_W / 2 - 100, 30, size=7, gray=150)

    elif doc_type == 'bought_sold_note':
        # ── Bought / Sold Note ──
        pdf.add_page()
        tx = transaction or (all_txs[0] if all_txs else {})

        def draw_ticket(side, start_x, start_y, col_w):
            y2 = start_y
            pdf_draw(pdf, f"買入票據 / Bought Note" if side == 'BUY' else "賣出票據 / Sold Note", start_x, y2, size=11)
            y2 -= 18
            draw_line_h(pdf, start_x, start_x + col_w, y2)
            y2 -= 14

            def draw(l, v):
                nonlocal y2
                pdf_draw(pdf, l, start_x, y2, size=7, gray=100)
                y2 -= 10
                pdf_draw(pdf, str(v or ''), start_x + 4, y2, size=8)
                y2 -= 16

            draw("公司 Company:", company['name'] or '')
            draw("BR:", company.get('company_number', ''))
            draw("日期 Date:", rget(tx, 'transaction_date'))
            draw("賣方 Seller:", rget(tx, 'from_name') if side == 'SELL' else "同上 As Above" if side == 'BUY' and rget(tx, 'from_name') else '')
            draw("買方 Buyer:", rget(tx, 'to_name') if side == 'BUY' else "同上 As Above" if side == 'SELL' and rget(tx, 'to_name') else '')
            draw("股份 Shares:", f"{tx.get('shares', '')} {rget(tx, 'share_type') or 'Ordinary'}" if tx else '')
            draw("價格 Price:", f"{rget(tx, 'currency') or 'HKD'} {rget(tx, 'price_per_share') or ''} per share" if tx else '')
            draw("總代價 Total:", rget(tx, 'total_consideration'))
            draw("經紀 Broker:", "Paul Tang & Co Ltd")
            draw("合約編號 Contract:", rget(tx, 'instrument_number'))
            y2 -= 10
            pdf_draw(pdf, "簽署 Signed: ____________", start_x, y2, size=8)

        colW = PAGE_W / 2 - MARGIN - 10
        draw_ticket('BUY', MARGIN, PAGE_H - 50, colW)
        draw_ticket('SELL', PAGE_W / 2 + 10, PAGE_H - 50, colW)
        pdf.set_draw_color(100, 100, 100)
        pdf.line(PAGE_W / 2, PAGE_H - 50, PAGE_W / 2, 50)
        pdf_draw(pdf, f"由 Muse Labs 秘書系統生成 | {datetime.now().strftime('%Y-%m-%d')}", MARGIN, 30, size=7, gray=150)

    else:
        # ── Instrument of Transfer ──
        pdf.add_page()
        tx = transaction or (all_txs[0] if all_txs else {})

        y = PAGE_H - 50
        pdf_draw(pdf, "股份轉讓文書 / Instrument of Transfer", MARGIN, y, size=15)
        y -= 8
        draw_line_h(pdf, MARGIN, PAGE_W - MARGIN, y, 80)
        y -= 22

        draw_label(pdf, MARGIN, y, "公司名稱 Company:", company['name'] or '')
        y -= 22
        draw_label(pdf, MARGIN, y, "BR 號碼:", company.get('company_number', ''))
        y -= 22
        if company.get('chinese_name'):
            draw_label(pdf, MARGIN, y, "中文名稱:", company['chinese_name'])
            y -= 22
        y -= 12
        pdf_draw(pdf, "轉讓詳情 / Transfer Details", MARGIN, y, size=12)
        draw_line_h(pdf, MARGIN, PAGE_W - MARGIN, y - 4, 130)
        y -= 20
        draw_label(pdf, MARGIN, y, "轉讓人 Transferor:", rget(tx, 'from_name'))
        y -= 22
        draw_label(pdf, MARGIN, y, "受讓人 Transferee:", rget(tx, 'to_name'))
        y -= 22
        draw_label(pdf, MARGIN, y, "股份數目 No. of Shares:", str(tx.get('shares', '')) if tx else '')
        y -= 22
        draw_label(pdf, MARGIN, y, "股份類別 Share Class:", rget(tx, 'share_type') or 'Ordinary')
        y -= 22
        draw_label(pdf, MARGIN, y, "每股代價 Price per Share:", f"{rget(tx, 'currency') or 'HKD'} {rget(tx, 'price_per_share') or ''}" if tx else '')
        y -= 22
        draw_label(pdf, MARGIN, y, "總代價 Total Consideration:", rget(tx, 'total_consideration'))
        y -= 22
        draw_label(pdf, MARGIN, y, "轉讓日期 Transfer Date:", rget(tx, 'transaction_date'))
        y -= 22
        draw_label(pdf, MARGIN, y, "文書編號 Instrument No:", rget(tx, 'instrument_number'))
        y -= 30
        pdf_draw(pdf, "轉讓人簽署 / Signed by Transferor:", MARGIN, y, size=10)
        pdf_draw(pdf, "____________________________", MARGIN + 200, y, size=10)
        y -= 25
        pdf_draw(pdf, "受讓人簽署 / Signed by Transferee:", MARGIN, y, size=10)
        pdf_draw(pdf, "____________________________", MARGIN + 200, y, size=10)
        y -= 25
        pdf_draw(pdf, "日期 Date: ____/____/________", MARGIN, y, size=10)
        pdf_draw(pdf, f"由 Muse Labs 秘書系統生成 | {datetime.now().strftime('%Y-%m-%d')}", MARGIN, 30, size=7, gray=150)

    pdf_bytes = bytes(pdf.output())
    import base64 as b64
    return jsonify({'pdf': b64.b64encode(pdf_bytes).decode('ascii')})


# ─── R2 存儲本地替身（文件系統，鏡像生產 /api/storage/<bucket>/<file...>）───
STORAGE_ROOT = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'storage')
STORAGE_BUCKETS = {'pdf-templates', 'company-documents', 'company-logs', 'backups'}


def _storage_resolve(bucket, filepath):
    """把 <bucket>/<filepath> 解析成安全的本地絕對路徑，阻止路徑穿越。非法返回 None。"""
    if bucket not in STORAGE_BUCKETS:
        return None
    bucket_dir = os.path.abspath(os.path.join(STORAGE_ROOT, bucket))
    target = os.path.abspath(os.path.join(bucket_dir, filepath))
    # 確保 target 仍在 bucket_dir 之內（防 ../ 穿越）
    if target != bucket_dir and not target.startswith(bucket_dir + os.sep):
        return None
    return target


@app.route('/api/storage/<bucket>/<path:filepath>', methods=['GET', 'OPTIONS'])
def storage_get(bucket, filepath):
    if request.method == 'OPTIONS':
        return ('', 204)
    target = _storage_resolve(bucket, filepath)
    if not target:
        return jsonify({'error': 'Invalid bucket or path'}), 400
    if not os.path.isfile(target):
        return jsonify({'error': 'File not found'}), 404
    import mimetypes
    ctype = mimetypes.guess_type(target)[0] or 'application/octet-stream'
    with open(target, 'rb') as f:
        data = f.read()
    resp = Response(data, mimetype=ctype)
    dl = request.args.get('download')
    if dl:
        resp.headers['Content-Disposition'] = f'attachment; filename="{dl}"'
    resp.headers['Cache-Control'] = 'public, max-age=3600'
    return resp


@app.route('/api/storage/<bucket>/<path:filepath>', methods=['POST'])
def storage_put(bucket, filepath):
    target = _storage_resolve(bucket, filepath)
    if not target:
        return jsonify({'error': 'Invalid bucket or path'}), 400
    os.makedirs(os.path.dirname(target), exist_ok=True)
    with open(target, 'wb') as f:
        f.write(request.get_data())
    return jsonify({'success': True, 'path': filepath}), 201


@app.route('/api/storage/<bucket>/<path:filepath>', methods=['DELETE'])
def storage_delete(bucket, filepath):
    target = _storage_resolve(bucket, filepath)
    if not target:
        return jsonify({'error': 'Invalid bucket or path'}), 400
    if os.path.isfile(target):
        os.remove(target)
    return jsonify({'success': True})


# ─── Generic CRUD ───
# SQL-safe identifier pattern: alphanumeric + underscore, must start with letter or underscore
_SAFE_ID_RE = re.compile(r'^[a-zA-Z_][a-zA-Z0-9_]*$')

def _safe_ident(name: str) -> bool:
    """Return True if `name` is a safe SQL identifier (no injection risk)."""
    return bool(_SAFE_ID_RE.match(name))


@app.route('/api/<table_name>', methods=['GET'])
def table_list(table_name):
    if table_name not in TABLES:
        return jsonify({'error': 'Not found'}), 404
    db = get_db()
    # Build query from search params — supports operator suffixes: __neq, __gt, __lt,
    # __gte, __lte, __like, __ilike, __in, __is.  Plain keys → eq.
    reserved = {'search', 'limit', 'offset', '_order', '_order_dir'}
    where = []
    bindings = []
    for key in request.args:
        if key in reserved:
            continue
        val = request.args.get(key)
        if val is None or val == '':
            continue
        # Operator suffix: column__op
        if '__' in key:
            col, op = key.rsplit('__', 1)
            if not _safe_ident(col):
                continue  # skip unsafe column names
            if op == 'neq':
                where.append(f"{col} != ?")
                bindings.append(val)
            elif op == 'gt':
                where.append(f"{col} > ?")
                bindings.append(val)
            elif op == 'lt':
                where.append(f"{col} < ?")
                bindings.append(val)
            elif op == 'gte':
                where.append(f"{col} >= ?")
                bindings.append(val)
            elif op == 'lte':
                where.append(f"{col} <= ?")
                bindings.append(val)
            elif op in ('like', 'ilike'):
                where.append(f"{col} LIKE ?")
                bindings.append(val)
            elif op == 'in':
                vals = [v.strip() for v in val.split(',') if v.strip()]
                if vals:
                    placeholders = ','.join(['?'] * len(vals))
                    where.append(f"{col} IN ({placeholders})")
                    bindings.extend(vals)
            elif op == 'is':
                where.append(f"{col} IS {val}")  # val is SQL literal e.g. NULL, NOT NULL
            else:
                where.append(f"{key} = ?")
                bindings.append(val)
        else:
            if not _safe_ident(key):
                continue  # skip unsafe column names
            where.append(f"{key} = ?")
            bindings.append(val)
    search = request.args.get('search')
    if search:
        s = f"%{search}%"
        where.append("(name LIKE ? OR name_english LIKE ? OR name_chinese LIKE ?)")
        bindings.extend([s, s, s])
    sql = f"SELECT * FROM {table_name}"
    if where:
        sql += " WHERE " + " AND ".join(where)
    # Order: use _order param if provided, otherwise default to created_at DESC
    order_col = request.args.get('_order')
    if order_col and _safe_ident(order_col):
        order_dir = request.args.get('_order_dir', 'asc')
        sql += f" ORDER BY {order_col} {'DESC' if order_dir == 'desc' else 'ASC'}"
    else:
        try:
            db.execute(f"SELECT created_at FROM {table_name} LIMIT 1")
            sql += " ORDER BY created_at DESC"
        except sqlite3.OperationalError:
            pass
    limit = min(int(request.args.get( 'limit', '100')), 1000)
    offset = int(request.args.get( 'offset', '0'))
    sql += f" LIMIT {limit} OFFSET {offset}"
    rows = db.execute(sql, bindings).fetchall()
    return jsonify([dict(r) for r in rows])

@app.route('/api/<table_name>/<item_id>', methods=['GET'])
def table_get(table_name, item_id):
    if table_name not in TABLES:
        return jsonify({'error': 'Not found'}), 404
    db = get_db()
    row = db.execute(f"SELECT * FROM {table_name} WHERE id = ?", (item_id,)).fetchone()
    if not row:
        return jsonify({'error': 'Not found'}), 404
    return jsonify(dict(row))

# ─── Company version snapshots (VE-01/02/03/08) ───
# 需納入版本快照 / 差異比對的公司欄位 → 繁體標籤
VERSION_FIELDS = {
    'name': '英文名稱', 'chinese_name': '中文名稱', 'company_number': '商業登記號碼',
    'ci_number': '公司註冊編號', 'trading_name': '商業名稱', 'business_nature': '業務性質',
    'company_type': '公司類型', 'business_code': '業務代碼', 'status': '狀態',
    'incorporation_date': '成立日期', 'jurisdiction': '司法管轄區',
    'reg_flat': '註冊地址-室/樓/座', 'reg_building': '註冊地址-大廈',
    'reg_street': '註冊地址-街道', 'reg_district': '註冊地址-區', 'reg_region': '註冊地址-地區',
    'email': '電郵地址', 'phone': '電話', 'signer_role_id': '簽署人',
}


def _company_snapshot(db, company_id):
    """回傳公司當前資料的 dict 快照（僅 VERSION_FIELDS 欄位）。"""
    row = db.execute("SELECT * FROM companies WHERE id = ?", (company_id,)).fetchone()
    if not row:
        return None
    d = dict(row)
    return {k: (d.get(k) if d.get(k) is not None else '') for k in VERSION_FIELDS}


def _latest_version(db, company_id):
    """回傳該公司最新版本 row(dict)，無則 None。"""
    r = db.execute(
        "SELECT * FROM company_versions WHERE company_id = ? ORDER BY version_no DESC LIMIT 1",
        (company_id,)
    ).fetchone()
    return dict(r) if r else None


def record_company_version(db, company_id, changed_by=''):
    """在公司資料變更後寫入一筆版本快照。僅當相對上一版有差異（或首版）時寫入。
    回傳新版本號，或 None（無變化未寫入）。"""
    snap = _company_snapshot(db, company_id)
    if snap is None:
        return None
    prev = _latest_version(db, company_id)
    changed = []
    if prev:
        try:
            prev_snap = json.loads(prev.get('snapshot') or '{}')
        except (ValueError, TypeError):
            prev_snap = {}
        for k in VERSION_FIELDS:
            if str(prev_snap.get(k, '')) != str(snap.get(k, '')):
                changed.append(k)
        if not changed:
            return None  # 無實質變化，不製造重複版本
        version_no = int(prev.get('version_no') or 0) + 1
    else:
        version_no = 1  # 首版（基線），changed 留空
    labels = [VERSION_FIELDS[k] for k in changed]
    summary = ('建立初始版本' if version_no == 1
               else '更新：' + '、'.join(labels) if labels else '更新')
    db.execute(
        "INSERT INTO company_versions (id, company_id, version_no, snapshot, changed_fields, change_summary, changed_by) "
        "VALUES (?, ?, ?, ?, ?, ?, ?)",
        (str(uuid.uuid4()), company_id, version_no, json.dumps(snap, ensure_ascii=False),
         json.dumps(changed, ensure_ascii=False), summary, changed_by)
    )
    return version_no


@app.route('/api/companies/<company_id>/versions', methods=['GET'])
def company_versions_list(company_id):
    """列出公司所有版本（新→舊），含解析後的 snapshot / changed_fields。"""
    db = get_db()
    rows = db.execute(
        "SELECT * FROM company_versions WHERE company_id = ? ORDER BY version_no DESC",
        (company_id,)
    ).fetchall()
    out = []
    for r in rows:
        d = dict(r)
        try:
            d['snapshot'] = json.loads(d.get('snapshot') or '{}')
        except (ValueError, TypeError):
            d['snapshot'] = {}
        try:
            d['changed_fields'] = json.loads(d.get('changed_fields') or '[]')
        except (ValueError, TypeError):
            d['changed_fields'] = []
        out.append(d)
    return jsonify(out)


@app.route('/api/companies/<company_id>/versions/snapshot', methods=['POST'])
def company_version_snapshot(company_id):
    """手動建立一個當前資料的版本快照（VE 手動存檔）。"""
    db = get_db()
    changed_by = (request.json or {}).get('changed_by', '') if request.is_json else ''
    v = record_company_version(db, company_id, changed_by)
    db.commit()
    return jsonify({'success': True, 'version_no': v, 'created': v is not None})


@app.route('/api/<table_name>', methods=['POST'])
def table_create(table_name):
    if table_name not in TABLES:
        return jsonify({'error': 'Not found'}), 404
    data = request.json
    # Support both single object and array (batch) inserts
    rows = data if isinstance(data, list) else [data]
    db = get_db()
    ids = []
    for row in rows:
        if 'id' not in row:
            row['id'] = str(uuid.uuid4())
        keys = list(row.keys())
        vals = list(row.values())
        placeholders = ', '.join(['?'] * len(keys))
        db.execute(f"INSERT INTO {table_name} ({', '.join(keys)}) VALUES ({placeholders})", vals)
        ids.append(row['id'])
    db.commit()
    if isinstance(data, list):
        return jsonify({'success': True, 'ids': ids, 'count': len(ids)}), 201
    return jsonify({'success': True, 'id': ids[0]}), 201

@app.route('/api/<table_name>/<item_id>', methods=['PUT'])
def table_update(table_name, item_id):
    if table_name not in TABLES:
        return jsonify({'error': 'Not found'}), 404
    data = request.json
    db = get_db()
    sets = [f"{k} = ?" for k in data.keys()]
    vals = list(data.values()) + [item_id]
    db.execute(f"UPDATE {table_name} SET {', '.join(sets)}, updated_at = datetime('now') WHERE id = ?", vals)
    # 公司資料變更後，自動記錄版本快照（VE-01/02/03）
    if table_name == 'companies':
        try:
            record_company_version(db, item_id)
        except Exception as e:
            print(f"[VERSION] snapshot failed: {e}")
    db.commit()
    return jsonify({'success': True})

@app.route('/api/<table_name>/<item_id>', methods=['DELETE'])
def table_delete(table_name, item_id):
    if table_name not in TABLES:
        return jsonify({'error': 'Not found'}), 404
    db = get_db()

    if table_name == 'companies':
        # ─── Cascade delete: clean up all related records ───
        # 1. Find persons that will become orphaned (only in this company)
        orphan_person_ids = [
            row[0] for row in db.execute(
                "SELECT person_id FROM person_company_roles WHERE company_id = ?", (item_id,)
            ).fetchall()
        ]
        # 2. Delete all related records across tables
        for tbl in ['person_company_roles', 'reminders', 'company_logs',
                     'resolutions', 'significant_controllers', 'share_transactions', 'invoices']:
            db.execute(f"DELETE FROM {tbl} WHERE company_id = ?", (item_id,))
        # 3. Delete orphaned persons (no remaining roles in any company)
        for pid in orphan_person_ids:
            remaining = db.execute(
                "SELECT COUNT(*) FROM person_company_roles WHERE person_id = ?", (pid,)
            ).fetchone()[0]
            if remaining == 0:
                db.execute("DELETE FROM persons WHERE id = ?", (pid,))
        # 4. officers & shareholders have ON DELETE CASCADE, auto-cleaned
        db.execute("DELETE FROM companies WHERE id = ?", (item_id,))
    elif table_name == 'persons':
        # Cascade: clean up person_company_roles before deleting person
        db.execute("DELETE FROM person_company_roles WHERE person_id = ?", (item_id,))
        db.execute("DELETE FROM persons WHERE id = ?", (item_id,))
    else:
        db.execute(f"DELETE FROM {table_name} WHERE id = ?", (item_id,))

    db.commit()
    return jsonify({'success': True})

@app.route('/api/<table_name>', methods=['DELETE'])
def table_delete_filtered(table_name):
    if table_name not in TABLES:
        return jsonify({'error': 'Not found'}), 404
    db = get_db()
    where = []
    bindings = []
    for key in request.args:
        where.append(f"{key} = ?")
        bindings.append(request.args.get(key))
    if where:
        db.execute(f"DELETE FROM {table_name} WHERE {' AND '.join(where)}", bindings)
    db.commit()
    return jsonify({'success': True})

# ─── Special routes ───
@app.route('/api/persons/cleanup-orphans', methods=['POST'])
def cleanup_orphan_persons():
    """Delete all persons that have no person_company_roles (no company binding)."""
    db = get_db()
    result = db.execute('''
        DELETE FROM persons WHERE id IN (
            SELECT p.id FROM persons p
            LEFT JOIN person_company_roles r ON p.id = r.person_id
            WHERE r.person_id IS NULL
        )
    ''')
    db.commit()
    count = result.rowcount
    return jsonify({'success': True, 'deleted': count})

@app.route('/api/search', methods=['GET'])
def search():
    q = request.args.get( 'q', '')
    if not q:
        return jsonify([])
    s = f"%{q}%"
    db = get_db()
    companies = db.execute(
        "SELECT id, name, chinese_name, company_number, ci_number, company_type, status, 'company' as type "
        "FROM companies WHERE name LIKE ? OR chinese_name LIKE ? OR company_number LIKE ? OR ci_number LIKE ? "
        "ORDER BY name LIMIT 30",
        (s, s, s, s)).fetchall()
    persons = db.execute(
        "SELECT id, name_english, name_chinese, identity, id_number, passport_number, 'person' as type "
        "FROM persons WHERE name_english LIKE ? OR name_chinese LIKE ? OR id_number LIKE ? OR passport_number LIKE ? "
        "ORDER BY name_english LIMIT 30",
        (s, s, s, s)).fetchall()
    out = [dict(r) for r in companies]
    for r in persons:
        p = dict(r)
        # 附上關聯公司+角色，讓前端點擊可定位公司登記冊
        p['roles'] = [dict(x) for x in db.execute(
            "SELECT pcr.role, pcr.date_ceased, c.id AS company_id, c.name AS company_name "
            "FROM person_company_roles pcr JOIN companies c ON c.id = pcr.company_id "
            "WHERE pcr.person_id = ?", (p['id'],)).fetchall()]
        out.append(p)
    return jsonify(out)

@app.route('/api/companies/<item_id>/full', methods=['GET'])
def company_full(item_id):
    db = get_db()
    company = db.execute("SELECT * FROM companies WHERE id = ?", (item_id,)).fetchone()
    if not company:
        return jsonify({'error': 'Not found'}), 404
    officers = db.execute("SELECT * FROM officers WHERE company_id = ?", (item_id,)).fetchall()
    # Read shareholders from person_company_roles (same source as frontend hooks)
    shareholder_roles = db.execute(
        "SELECT pcr.*, p.name_english AS person_name_english, p.name_chinese AS person_name_chinese, "
        "p.identity AS person_identity, p.id_number AS person_id_number, p.address AS person_address, "
        "p.email AS person_email, p.service_address AS person_service_address "
        "FROM person_company_roles pcr "
        "LEFT JOIN persons p ON p.id = pcr.person_id "
        "WHERE pcr.company_id = ? AND pcr.role = 'shareholder'",
        (item_id,)).fetchall()
    shareholders = [dict(r) for r in shareholder_roles]
    scrs = db.execute("SELECT * FROM significant_controllers WHERE company_id = ?", (item_id,)).fetchall()
    logs = db.execute("SELECT * FROM company_logs WHERE company_id = ?", (item_id,)).fetchall()
    return jsonify({**dict(company),
                    'officers': [dict(r) for r in officers],
                    'shareholders': [dict(r) for r in shareholders],
                    'significant_controllers': [dict(r) for r in scrs],
                    'logs': [dict(r) for r in logs]})

@app.route('/api/backup', methods=['POST'])
def backup():
    return jsonify({'success': True, 'message': 'Local backup skipped (dev mode)'})

# ─── NAR1 PDF 生成（本地 Python + PyMuPDF） ───
import fitz  # PyMuPDF

_CJK_RE = re.compile(r'[㐀-鿿豈-﫿]')
_PURE_NUMBER_RE = re.compile(r'^[\d,.\s]+$')
_ADDR_FLAT_RE = re.compile(
    r'^(?:flat|room|rm|unit|shop|suite|ste|workshop|portion|floor|flr|fl|'
    r'\d+/f|g/f|gf|lg/f|ug/f|m/f|b\d*/f)',
    re.IGNORECASE
)
_ADDR_BLOCK_RE = re.compile(
    r'^(?:block|blk|blc|tower|twr)',
    re.IGNORECASE
)
_ADDR_COUNTRY_RE = re.compile(
    r'(hong\s*kong|hk\b|china|prc|macau|macao|singapore|taiwan|united\s+\w+|\busa\b|\buk\b|canada|australia|japan|korea|h\.?k\.?\s*sar|香港|中國|澳門|台灣|新加坡|日本|韓國|英國|美國|加拿大|澳洲)',
    re.IGNORECASE
)
_ADDR_DISTRICT_HINTS = re.compile(
    r'(kowloon|hong\s*kong|new\s*territories|n\.t\.|island|wan\s*chai|central|tsim|mong\s*kok|sham\s*shui|kwun\s*tong|sha\s*tin|tai\s*po|tuen\s*mun|yuen\s*long|tsuen\s*wan|kwai\s*tsing|sai\s*kung|north\s*district|southern\s*district|eastern\s*district|九龍|香港島|新界|灣仔|中環|尖沙咀|旺角|深水埗|觀塘|沙田|大埔|屯門|元朗|荃灣|葵青|西貢|北區|南區|東區|中西區|離島|油尖旺|黃大仙|九龍城)',
    re.IGNORECASE
)

def _is_ascii(s):
    return all(ord(c) < 128 for c in s)

def _parse_english_name(full_name):
    """返回 (surname, otherNames)"""
    cleaned = re.sub(r'\s+', ' ', (full_name or '')).strip()
    if not cleaned or not any(c.isascii() and c.isalpha() for c in cleaned):
        return '', ''
    if _CJK_RE.search(cleaned):
        cleaned = re.sub(r'\s+', ' ', _CJK_RE.sub(' ', cleaned)).strip()
        if not cleaned:
            return '', ''
    if ',' in cleaned:
        segs = [s.strip() for s in cleaned.split(',') if s.strip()]
        if len(segs) >= 2:
            return segs[0], ' '.join(segs[1:])
        if len(segs) == 1:
            return segs[0], ''
    parts = cleaned.split()
    if not parts:
        return '', ''
    surname = parts[0].rstrip(',')
    other = ' '.join(parts[1:]).lstrip(', ')
    return surname, other

def _parse_address(addr):
    """Parse a comma-separated HK address into {flat, block, building, street, district, country}.

    Logic (after removing pure-number tokens):
    1. Pop country from end if it matches country regex
    2. Pop district from end if ≥3 parts remain OR it matches district hints
    3. Pop flat/unit prefixes from beginning (room, unit, floor, etc.)
    4. Pop block/tower prefixes from beginning (block, tower, etc.)
    5. Remaining: first part → building, rest → street
    """
    if not addr:
        return {'flat': '', 'block': '', 'building': '', 'street': '', 'district': '', 'country': ''}
    parts = [s.strip() for s in addr.split(',') if s.strip() and not _PURE_NUMBER_RE.match(s.strip())]
    if not parts:
        return {'flat': '', 'block': '', 'building': '', 'street': '', 'district': '', 'country': ''}
    if len(parts) == 1:
        return {'flat': '', 'block': '', 'building': '', 'street': parts[0], 'district': '', 'country': ''}

    # 1. Pop country from end
    country = ''
    if _ADDR_COUNTRY_RE.search(parts[-1]):
        country = parts.pop()

    # 2. Pop district from end if it looks like one
    district = ''
    if len(parts) >= 2:
        last = parts[-1]
        # District if: ≥3 parts remaining (safe heuristic) OR matches known district name
        if len(parts) >= 3 or _ADDR_DISTRICT_HINTS.search(last):
            district = parts.pop()

    # 3. Pop flat/unit/floor prefixes from beginning (NOT block/tower)
    flat_parts = []
    while len(parts) > 1 and _ADDR_FLAT_RE.match(parts[0]):
        flat_parts.append(parts.pop(0))
    flat = ', '.join(flat_parts)

    # 4. Pop block/tower prefixes from beginning
    block_parts = []
    while len(parts) > 1 and _ADDR_BLOCK_RE.match(parts[0]):
        block_parts.append(parts.pop(0))
    block = ', '.join(block_parts)

    # 5. Building + street
    building = parts.pop(0) if parts else ''
    street = ', '.join(parts)
    return {'flat': flat, 'block': block, 'building': building, 'street': street, 'district': district, 'country': country}

def _parse_hkid_partial(id_number):
    if not id_number:
        return ''
    return re.sub(r'[()\-\s]', '', id_number).upper()[:4]

def _parse_passport_partial(passport_number):
    if not passport_number:
        return ''
    cleaned = re.sub(r'[^A-Za-z0-9]', '', passport_number).upper()
    return cleaned[:len(cleaned) // 2 + len(cleaned) % 2]

def _fmt_amount(n):
    return f'{n:,.2f}'

def _fmt_int(n):
    return f'{n:,}'

def _build_field_page_map(doc):
    """遍歷所有頁面，建立 field_name → page_index 映射（不存儲 widget 引用，避免 Annot not bound to page）"""
    fmap = {}
    for pi in range(doc.page_count):
        for w in doc[pi].widgets():
            name = w.field_name
            if name:
                fmap[name] = pi
    return fmap

# Cached CJK font path for _set_text valign='top' overlay
_SET_TEXT_CJK_FONTFILE = None
_SET_TEXT_CJK_LOOKED = False

def _get_set_text_cjk_font():
    global _SET_TEXT_CJK_FONTFILE, _SET_TEXT_CJK_LOOKED
    if _SET_TEXT_CJK_LOOKED:
        return _SET_TEXT_CJK_FONTFILE
    _SET_TEXT_CJK_LOOKED = True
    for sf in ['C:/Windows/Fonts/simhei.ttf', 'C:/Windows/Fonts/simsun.ttc',
               'C:/Windows/Fonts/msjh.ttc', 'C:/Windows/Fonts/Deng.ttf']:
        if os.path.exists(sf):
            _SET_TEXT_CJK_FONTFILE = sf
            return sf
    return None

# Track which pages already have CJK_ST font embedded (for _set_text valign='top')
_SET_TEXT_CJK_PAGES = set()


def _set_text(doc, fmap, name, value, min_fs=6, valign='bottom'):
    """在指定頁面上查找 widget 並設置值（必須在迭代內完成 update，widget 引用不能外傳）
    自適應字號：文字過長時自動縮小，寬欄位（如地址）可設較高 min_fs 保持可讀性。
    valign='top' 用 insert_textbox 疊加文字到欄位頂部，'bottom' 為預設 w.update()。"""
    if name not in fmap:
        return False
    pi = fmap[name]
    for w in doc[pi].widgets():
        if w.field_name == name:
            try:
                # Use str(value) for all non-None values, including 0 and 0.0.
                # Only treat None and empty string as "no value".
                if value is None:
                    return False
                vstr = str(value)
                if not vstr:
                    return False
                # Adaptive font size based on field width
                fs = w.text_fontsize if w.text_fontsize and w.text_fontsize > 0 else 10
                field_w = w.rect.width
                field_h = w.rect.height
                cjk_n = sum(1 for c in vstr if ord(c) > 127)
                asc_n = len(vstr) - cjk_n
                # Deduct inset from usable width: 3pt for CJK overlay, 4pt for bottom-aligned (field padding)
                if valign == 'top' and cjk_n > 0:
                    usable_w = field_w - 3.0
                else:
                    usable_w = field_w - 4.0  # bottom-aligned: account for field padding
                if usable_w > 0:
                    est_w = fs * (cjk_n * 1.0 + asc_n * 0.52)
                    if est_w > usable_w:
                        fs = max(min_fs, int(fs * usable_w / est_w * 0.95))
                if field_h > 0:
                    fs = min(fs, max(min_fs, int(field_h - 2)))

                if cjk_n > 0:
                    # CJK text — w.update() always uses Helv which cannot render
                    # Chinese characters.  Use insert_textbox overlay instead.
                    fontfile = _get_set_text_cjk_font()
                    if fontfile:
                        # Set value in form field + hide the Helv widget
                        doc.xref_set_key(w._annot.xref, 'V', fitz.get_pdf_str(vstr))
                        doc.xref_set_key(w._annot.xref, 'F', '3')
                        page = doc[pi]
                        try:
                            page.clean_contents()
                        except Exception:
                            pass
                        if pi not in _SET_TEXT_CJK_PAGES:
                            page.insert_font(fontname='CJK_ST', fontfile=fontfile)
                            _SET_TEXT_CJK_PAGES.add(pi)
                        # Text rect: for valign='top', shrink to single-line height
                        # so text stays at field top (matching ASCII top-align behavior)
                        if valign == 'top':
                            text_rect = fitz.Rect(
                                w.rect.x0 + 2, w.rect.y0 + 1,
                                w.rect.x1 - 2, w.rect.y0 + 1 + fs + 4)
                        else:
                            text_rect = fitz.Rect(
                                w.rect.x0 + 2, w.rect.y0 + 1,
                                w.rect.x1 - 2, w.rect.y1 - 1)
                        page.insert_textbox(text_rect, vstr, fontname='CJK_ST', fontsize=fs)
                elif valign == 'top':
                    # ASCII, top-aligned: shrink rect so w.update() puts text at field top
                    single_rect = fitz.Rect(w.rect.x0, w.rect.y0,
                                            w.rect.x1, w.rect.y0 + fs + 4)
                    w.rect = single_rect
                    w.field_value = vstr
                    w.text_fontsize = fs
                    w.update()
                else:
                    w.field_value = vstr
                    w.text_fontsize = fs
                    w.update()
                return True
            except Exception:
                pass
            break
    return False

def _check(doc, fmap, name, should_check):
    """在指定頁面上查找 checkbox 並勾選"""
    if not should_check or name not in fmap:
        return False
    pi = fmap[name]
    for w in doc[pi].widgets():
        if w.field_name == name:
            try:
                # Discover the checkbox "On" state name from /AP/N dictionary
                on_state = 'Yes'
                try:
                    ap = w._annot.get('AP')
                    if ap:
                        ap_n = ap.get('N')
                        if ap_n and hasattr(ap_n, 'keys'):
                            for k in ap_n.keys():
                                kname = str(k).lstrip('/')
                                if kname and kname != 'Off':
                                    on_state = kname
                                    break
                except Exception:
                    pass
                w.field_value = on_state
                w.update()
                return True
            except Exception:
                pass
            break
    return False

def _stamp_br_on_page(doc, page_index, br_text):
    """在指定頁面上用 insert_textbox 疊加 BR 號碼（數字字體，不依賴 AcroForm widget）。
    放在頁面頂部靠右位置，確保每一頁都有商業登記號碼。"""
    if not br_text:
        return
    page = doc[page_index]
    rect = page.rect
    # 頂部靠右：x=rect.width-140, y=12, w=120, h=14
    text_rect = fitz.Rect(rect.width - 150, 15, rect.width - 10, 30)
    try:
        page.insert_textbox(
            text_rect,
            f"BR: {br_text}",
            fontname="helv",
            fontsize=7,
            color=(0.2, 0.2, 0.2),
            align=2,  # right-align
        )
    except Exception:
        pass  # 若頁面無法插入文字則靜默跳過

def _stamp_br_on_all_pages(doc, br_text):
    """在 PDF 每一頁疊加 BR 號碼"""
    if not br_text or not br_text.strip():
        return
    for pi in range(doc.page_count):
        _stamp_br_on_page(doc, pi, br_text)

def _fill_nar1_pdf(data):
    """填充 NAR1 PDF 模板，返回 bytes"""
    import os
    template_path = os.path.join(os.path.dirname(__file__), '..', 'public', 'templates', 'NAR1-template-new.pdf')
    doc = fitz.open(template_path)
    fmap = _build_field_page_map(doc)

    return_date = data.get('returnDate', '')
    if return_date:
        parts = return_date.split('-')
        year, month, day = parts[0], parts[1], parts[2]
    else:
        from datetime import date
        today = date.today()
        year, month, day = str(today.year), f'{today.month:02d}', f'{today.day:02d}'

    office = data.get('registeredOffice') or {}
    br8 = re.sub(r'[^0-9A-Za-z]', '', str(data.get('brNumber') or ''))[:8]
    company_type = data.get('companyType') or ''
    ct_lower = company_type.lower()

    # ── CJK font setup for widget AP (blue editable boxes) ──
    _nar1_cjk_fontfile = None
    for _sf in ['C:/Windows/Fonts/simhei.ttf', 'C:/Windows/Fonts/simsun.ttc',
                 'C:/Windows/Fonts/msjh.ttc', 'C:/Windows/Fonts/Deng.ttf']:
        if os.path.exists(_sf):
            _nar1_cjk_fontfile = _sf
            break
    _nar1_cjk_ap_font_pages = set()
    _nar1_cjk_ap_font_xref_map = {}

    def _set_field_ap(name, value, fontsize=10, align='left', valign='bottom'):
        """Like _set_text but uses _set_widget_cjk_ap to keep the blue editable box.
        Falls back to _set_text if no CJK font is available."""
        if name not in fmap:
            return False
        vstr = str(value) if value is not None else ''
        if not vstr or not _nar1_cjk_fontfile:
            return _set_text(doc, fmap, name, value)
        pi = fmap[name]
        for w in doc[pi].widgets():
            if w.field_name == name:
                try:
                    _set_widget_cjk_ap(
                        doc, doc[pi], w, vstr, fontsize,
                        _nar1_cjk_fontfile, _nar1_cjk_ap_font_pages,
                        _nar1_cjk_ap_font_xref_map, align=align, valign=valign)
                    return True
                except Exception:
                    pass
                break
        return _set_text(doc, fmap, name, value)

    # ── P.1 公司資料 ──
    _set_text(doc, fmap, 'fill_1_P.1', br8)
    full_name = '\n'.join(filter(None, [data.get('name', ''), data.get('chineseName', '')]))
    _set_field_ap('fill_2_P.1', full_name, fontsize=10, align='center')
    _set_field_ap('fill_3_P.1', data.get('tradingName', ''), fontsize=10)
    _check(doc, fmap, 'cb_1_P.1', '私人' in company_type or 'private' in ct_lower)
    _check(doc, fmap, 'cb_2_P.1', '公眾' in company_type or 'public' in ct_lower)
    _check(doc, fmap, 'cb_3_P.1', '擔保' in company_type)
    _set_text(doc, fmap, 'fill_4_P.1', data.get('businessCode', ''))
    _set_field_ap('fill_5_P.1', data.get('businessNature', ''), fontsize=10)
    _set_text(doc, fmap, 'fill_6_P.1', day)
    _set_text(doc, fmap, 'fill_7_P.1', month)
    _set_text(doc, fmap, 'fill_8_P.1', year)
    # 5. 財務報表期間
    _set_text(doc, fmap, 'fill_9_P.1', data.get('financialStartDay', ''))
    _set_text(doc, fmap, 'fill_10_P.1', data.get('financialStartMonth', ''))
    _set_text(doc, fmap, 'fill_11_P.1', data.get('financialStartYear', ''))
    _set_text(doc, fmap, 'fill_12_P.1', data.get('financialEndDay', ''))
    _set_text(doc, fmap, 'fill_13_P.1', data.get('financialEndMonth', ''))
    _set_text(doc, fmap, 'fill_14_P.1', data.get('financialEndYear', ''))
    _set_text(doc, fmap, 'fill_15_P.1', office.get('flat', ''))
    _set_text(doc, fmap, 'fill_16_P.1', office.get('building', ''))
    _set_text(doc, fmap, 'fill_17_P.1', office.get('street', ''))
    _set_field_ap('fill_18_P.1', office.get('district', ''), fontsize=10)
    # 區域 — 藍色可編輯框
    if office.get('region'):
        for name in ['Dropdown1_P.1', 'Dropdown_1_P.1']:
            if name in fmap:
                _set_field_ap(name, office['region'], fontsize=10, align='center')
                break

    presenter = data.get('presenter') or {}
    if presenter.get('name'):
        _set_text(doc, fmap, 'fill_19_P.1', presenter['name'])
    if presenter.get('address'):
        _set_text(doc, fmap, 'fill_20_P.1', presenter['address'], min_fs=9)
    if presenter.get('phone'):
        _set_text(doc, fmap, 'fill_21_P.1', presenter['phone'])
    if presenter.get('fax'):
        _set_text(doc, fmap, 'fill_22_P.1', presenter['fax'])
    if presenter.get('email'):
        _set_text(doc, fmap, 'fill_23_P.1', presenter['email'])
    if presenter.get('reference'):
        _set_text(doc, fmap, 'fill_24_P.1', presenter['reference'])

    # ── P.2 股本 ──
    _set_text(doc, fmap, 'fill_1_P.2', br8)
    _set_text(doc, fmap, 'fill_2_P.2', data.get('email', ''))
    _set_text(doc, fmap, 'fill_3_P.2', data.get('phone', ''))
    shareholders = data.get('shareholders') or []

    def _norm_class(raw):
        t = (raw or '').strip()
        if not t or 'ord' in t.lower() or '普通' in t:
            return 'ORDINARY SHARES'
        if 'pref' in t.lower() or '優先' in t:
            return 'PREFERENCE SHARES'
        return t.upper()

    def _norm_currency(raw):
        c = (raw or 'HKD').strip().upper()
        return 'HK$' if c in ('HKD', 'HK$') else ('US$' if c in ('USD', 'US$') else c)

    share_type_map = {}
    for sh in shareholders:
        cls = _norm_class(sh.get('shareType', ''))
        cur = _norm_currency(sh.get('currency', ''))
        ip = float(sh.get('issuePrice', 0) or 0)
        key = f'{cls}||{cur}||{ip}'
        if key not in share_type_map:
            share_type_map[key] = {'className': cls, 'currency': cur, 'issuePrice': ip, 'shares': 0, 'paidUp': 0.0, 'unpaid': 0.0}
        info = share_type_map[key]
        info['shares'] += int(sh.get('shares', 0) or 0)
        info['paidUp'] += float(sh.get('paidUp', 0) or 0)
        info['unpaid'] += float(sh.get('unpaid', 0) or 0)

    share_infos = list(share_type_map.values())
    total_shares, total_amount, total_paid, first_currency = 0, 0.0, 0.0, ''
    for i, info in enumerate(share_infos[:4]):
        base = 6 + i * 5
        issued = (info['paidUp'] + info['unpaid']) or (info['issuePrice'] * info['shares'])
        _set_text(doc, fmap, f'fill_{base}_P.2', info['className'])
        _set_text(doc, fmap, f'fill_{base+1}_P.2', info['currency'])
        _set_text(doc, fmap, f'fill_{base+2}_P.2', _fmt_int(info['shares']))
        if issued:
            _set_text(doc, fmap, f'fill_{base+3}_P.2', _fmt_amount(issued))
        _set_text(doc, fmap, f'fill_{base+4}_P.2', _fmt_amount(info['paidUp'] or issued))
        total_shares += info['shares']
        total_amount += issued
        total_paid += info['paidUp'] or issued
        if not first_currency:
            first_currency = info['currency']

    if share_infos:
        _set_text(doc, fmap, 'fill_26_P.2', first_currency)
        _set_text(doc, fmap, 'fill_27_P.2', _fmt_int(total_shares))
        if total_amount:
            _set_text(doc, fmap, 'fill_28_P.2', _fmt_amount(total_amount))
        if total_paid:
            _set_text(doc, fmap, 'fill_29_P.2', _fmt_amount(total_paid))

    secretaries = data.get('secretaries') or []
    directors = data.get('directors') or []
    nat_secs = [s for s in secretaries if s.get('identity') == 'natural']
    corp_secs = [s for s in secretaries if s.get('identity') == 'corporate']
    nat_dirs = [d for d in directors if d.get('identity') == 'natural']
    corp_dirs = [d for d in directors if d.get('identity') == 'corporate']

    # ── P.3 自然人秘書 ──
    _set_text(doc, fmap, 'fill_1_P.3', br8)
    if nat_secs:
        s = nat_secs[0]
        surname, other = _parse_english_name(s.get('nameEnglish', ''))
        _set_field_ap('fill_2_P.3', s.get('nameChinese', ''), fontsize=10, align='center')
        _set_text(doc, fmap, 'fill_3_P.3', surname)
        _set_text(doc, fmap, 'fill_4_P.3', other)
        addr = _parse_address(s.get('address', ''))
        addr['building'] = ', '.join(filter(None, [addr.pop('block', ''), addr['building']]))
        _set_text(doc, fmap, 'fill_9_P.3', addr['flat'])
        _set_text(doc, fmap, 'fill_10_P.3', addr['building'])
        _set_text(doc, fmap, 'fill_11_P.3', addr['street'])
        _set_field_ap('fill_12_P.3', addr['district'], fontsize=10)
        _set_text(doc, fmap, 'fill_13_P.3', s.get('email', ''))
        hkid = _parse_hkid_partial(s.get('idNumber', ''))
        if hkid:
            _set_text(doc, fmap, 'fill_14_P.3', hkid)

    # ── P.4 法人秘書 ──
    _set_text(doc, fmap, 'fill_1_P.4', br8)
    if corp_secs:
        s = corp_secs[0]
        _set_text(doc, fmap, 'fill_2_P.4', s.get('nameChinese', ''))
        _set_text(doc, fmap, 'fill_3_P.4', s.get('nameEnglish', ''))
        addr = _parse_address(s.get('serviceAddress') or s.get('address', ''))
        addr['building'] = ', '.join(filter(None, [addr.pop('block', ''), addr['building']]))
        _set_text(doc, fmap, 'fill_4_P.4', addr['flat'])
        _set_text(doc, fmap, 'fill_5_P.4', addr['building'])
        _set_text(doc, fmap, 'fill_6_P.4', addr['street'])
        _set_field_ap('fill_7_P.4', addr['district'], fontsize=10)
        _set_text(doc, fmap, 'fill_8_P.4', s.get('email', ''))
        _set_text(doc, fmap, 'fill_9_P.4', s.get('companyNumberRef') or s.get('brNumber', ''))
        tcsp = s.get('tcspNumber', '') or s.get('licenceNumber', '')
        if tcsp:
            _set_text(doc, fmap, 'fill_10_P.4', tcsp)

    # ── P.5 自然人董事 ──
    _set_text(doc, fmap, 'fill_1_P.5', br8)
    if nat_dirs:
        d = nat_dirs[0]
        _check(doc, fmap, 'cb_1_P.5', True)
        surname, other = _parse_english_name(d.get('nameEnglish', ''))
        _set_field_ap('fill_3_P.5', d.get('nameChinese', ''), fontsize=10, align='center')
        _set_text(doc, fmap, 'fill_4_P.5', surname)
        _set_text(doc, fmap, 'fill_5_P.5', other)
        # Directors use registered office as address
        _set_text(doc, fmap, 'fill_10_P.5', office.get('flat', ''))
        _set_text(doc, fmap, 'fill_11_P.5', office.get('building', ''))
        _set_text(doc, fmap, 'fill_12_P.5', office.get('street', ''))
        _set_field_ap('fill_13_P.5', office.get('district', ''), fontsize=10)
        _set_field_ap('fill_14_P.5', office.get('region', ''), fontsize=10)
        _set_text(doc, fmap, 'fill_15_P.5', d.get('email', ''))
        hkid = _parse_hkid_partial(d.get('idNumber', ''))
        if hkid:
            _set_text(doc, fmap, 'fill_16_P.5', hkid)
        elif d.get('passportNumber'):
            _set_text(doc, fmap, 'fill_17_P.5', d.get('nationality', '') or d.get('placeIncorporated', ''))
            _set_text(doc, fmap, 'fill_18_P.5', _parse_passport_partial(d['passportNumber']))

    # ── P.6 法人董事 ──
    _set_text(doc, fmap, 'fill_1_P.6', br8)
    if corp_dirs:
        d = corp_dirs[0]
        _check(doc, fmap, 'cb_1_P.6', True)
        _set_field_ap('fill_3_P.6', d.get('nameChinese', ''), fontsize=10, align='center')
        _set_text(doc, fmap, 'fill_4_P.6', d.get('nameEnglish', ''))
        _set_text(doc, fmap, 'fill_5_P.6', office.get('flat', ''))
        _set_text(doc, fmap, 'fill_6_P.6', office.get('building', ''))
        _set_text(doc, fmap, 'fill_7_P.6', office.get('street', ''))
        _set_field_ap('fill_8_P.6', office.get('district', ''), fontsize=10)
        _set_field_ap('fill_9_P.6', office.get('region', ''), fontsize=10)
        _set_text(doc, fmap, 'fill_10_P.6', d.get('email', ''))
        _set_text(doc, fmap, 'fill_11_P.6', d.get('companyNumberRef') or d.get('brNumber', ''))

    # ── P.7 ──
    _set_text(doc, fmap, 'fill_1_P.7', br8)

    # ── P.8 總結 + 簽署 ──
    _set_text(doc, fmap, 'fill_1_P.8', br8)
    valid_members = [sh for sh in shareholders if (int(sh.get('shares', 0) or 0)) > 0]
    is_listed = '上市' in company_type or 'listed' in ct_lower
    if not is_listed:
        _check(doc, fmap, 'cb_4_P.8', True)

    sheet_a = max(0, len(nat_secs) - 1)
    sheet_b = max(0, len(corp_secs) - 1)
    sheet_c = max(0, len(nat_dirs) - 1)
    sheet_d_pages = max(0, (len(corp_dirs) - 1 + 1) // 2) if len(corp_dirs) > 1 else 0
    sched1_pages = 0 if is_listed else ((len(valid_members) + 1) // 2 if valid_members else 0)
    sched2_pages = 1 if is_listed else 0

    if sheet_a > 0:
        _set_text(doc, fmap, 'fill_4_P.8', str(sheet_a))
    if sheet_b > 0:
        _set_text(doc, fmap, 'fill_5_P.8', str(sheet_b))
    if sheet_c > 0:
        _set_text(doc, fmap, 'fill_6_P.8', str(sheet_c))
    if sheet_d_pages > 0:
        _set_text(doc, fmap, 'fill_7_P.8', str(sheet_d_pages))
    if sched1_pages > 0:
        _set_text(doc, fmap, 'fill_9_P.8', str(sched1_pages))
    if sched2_pages > 0:
        _set_text(doc, fmap, 'fill_10_P.8', str(sched2_pages))

    # 簽署人
    signer = data.get('signer')
    signer_name = (signer or {}).get('name') or presenter.get('name', '')
    if signer_name:
        _set_text(doc, fmap, 'fill_11_P.8', signer_name)
    if day and month and year:
        _set_text(doc, fmap, 'fill_12_P.8', f'{day}/{month}/{year}')

    # ── P.9 附表一（股東，前2人） ──
    # Always set BR on every page
    _set_text(doc, fmap, 'fill_4_P.9', br8)
    if valid_members and not is_listed:
        _set_text(doc, fmap, 'fill_1_P.9', day)
        _set_text(doc, fmap, 'fill_2_P.9', month)
        _set_text(doc, fmap, 'fill_3_P.9', year)
        if share_infos:
            _set_text(doc, fmap, 'fill_5_P.9', share_infos[0]['className'])
            _set_text(doc, fmap, 'fill_6_P.9', _fmt_int(share_infos[0]['shares']))

        # P.9 字段映射（2026-07-20 修正）：fill_16/fill_27=No. of Shares Held(右边窄框),
        # fill_10/fill_21=Name in English(左边宽框, 法人用)
        # SH1: name=7, surname=8, other=9, corp_en=10, shares=16, addr=11-15
        # SH2: name=18, surname=19, other=20, corp_en=21, shares=27, addr=22-26
        slots_ts = [
            {'name': 7, 'surname': 8, 'other': 9, 'corp_en': 10, 'shares': 16, 'flat': 11, 'building': 12, 'street': 13, 'district': 14, 'country': 15},
            {'name': 18, 'surname': 19, 'other': 20, 'corp_en': 21, 'shares': 27, 'flat': 22, 'building': 23, 'street': 24, 'district': 25, 'country': 26},
        ]
        for idx, sh in enumerate(valid_members[:2]):
            F = slots_ts[idx]
            is_corp = sh.get('identity') == 'corporate'
            full = sh.get('nameEnglish') or sh.get('name', '')
            surname, other = _parse_english_name(full)
            addr = _parse_address(sh.get('address', ''))
            addr['building'] = ', '.join(filter(None, [addr.pop('block', ''), addr['building']]))
            def _safe(v):
                return '' if (v and _PURE_NUMBER_RE.match(v)) else v
            country = _safe(addr['country']) or '香港 Hong Kong'

            _set_field_ap(f'fill_{F["name"]}_P.9', sh.get('nameChinese', ''), fontsize=10, align='center')
            if is_corp:
                _set_text(doc, fmap, f'fill_{F["corp_en"]}_P.9', full)
            else:
                _set_text(doc, fmap, f'fill_{F["surname"]}_P.9', surname)
                _set_text(doc, fmap, f'fill_{F["other"]}_P.9', other)
            shares_num = int(sh.get('shares', 0) or 0)
            _set_text(doc, fmap, f'fill_{F["shares"]}_P.9', _fmt_int(shares_num) if shares_num > 0 else '0')
            _set_text(doc, fmap, f'fill_{F["flat"]}_P.9', _safe(addr['flat']))
            _set_text(doc, fmap, f'fill_{F["building"]}_P.9', _safe(addr['building']))
            _set_text(doc, fmap, f'fill_{F["street"]}_P.9', _safe(addr['street']))
            _set_field_ap(f'fill_{F["district"]}_P.9', _safe(addr['district']), fontsize=10)
            _set_field_ap(f'fill_{F["country"]}_P.9', country, fontsize=10)

        total_sch1 = (len(valid_members) + 1) // 2
        _set_text(doc, fmap, 'fill_31_P.9', '1')  # current page
        _set_text(doc, fmap, 'fill_32_P.9', str(total_sch1))

    # ── P.10 附表一續（股東 #3+#4）──
    # Always set BR on every page
    _set_text(doc, fmap, 'fill_4_P.10', br8)
    if len(valid_members) > 2 and not is_listed:
        _set_text(doc, fmap, 'fill_1_P.10', day)
        _set_text(doc, fmap, 'fill_2_P.10', month)
        _set_text(doc, fmap, 'fill_3_P.10', year)
        if share_infos:
            _set_text(doc, fmap, 'fill_5_P.10', share_infos[0]['className'])
            _set_text(doc, fmap, 'fill_6_P.10', _fmt_int(share_infos[0]['shares']))
        # P.10 字段映射（2026-07-20 修正）：fill_16/fill_28=No. of Shares Held(右边窄框),
        # fill_10/fill_22=Name in English(左边宽框, 法人用)
        # SH1: name=7, surname=8, other=9, corp_en=10, shares=16, addr=11-15
        # SH2: name=19, surname=20, other=21, corp_en=22, shares=28, addr=23-27
        slots_p10 = [
            {'name': 7, 'surname': 8, 'other': 9, 'corp_en': 10, 'shares': 16, 'flat': 11, 'building': 12, 'street': 13, 'district': 14, 'country': 15},
            {'name': 19, 'surname': 20, 'other': 21, 'corp_en': 22, 'shares': 28, 'flat': 23, 'building': 24, 'street': 25, 'district': 26, 'country': 27},
        ]
        for idx, sh in enumerate(valid_members[2:4]):
            F = slots_p10[idx]
            is_corp = sh.get('identity') == 'corporate'
            full = sh.get('nameEnglish') or sh.get('name', '')
            surname, other = _parse_english_name(full)
            addr = _parse_address(sh.get('address', ''))
            addr['building'] = ', '.join(filter(None, [addr.pop('block', ''), addr['building']]))
            def _safe(v):
                return '' if (v and _PURE_NUMBER_RE.match(v)) else v
            country = _safe(addr['country']) or '香港 Hong Kong'
            _set_field_ap(f'fill_{F["name"]}_P.10', sh.get('nameChinese', ''), fontsize=10, align='center')
            if is_corp:
                _set_text(doc, fmap, f'fill_{F["corp_en"]}_P.10', full)
            else:
                _set_text(doc, fmap, f'fill_{F["surname"]}_P.10', surname)
                _set_text(doc, fmap, f'fill_{F["other"]}_P.10', other)
            shares_num = int(sh.get('shares', 0) or 0)
            _set_text(doc, fmap, f'fill_{F["shares"]}_P.10', _fmt_int(shares_num) if shares_num > 0 else '0')
            _set_text(doc, fmap, f'fill_{F["flat"]}_P.10', _safe(addr['flat']))
            _set_text(doc, fmap, f'fill_{F["building"]}_P.10', _safe(addr['building']))
            _set_text(doc, fmap, f'fill_{F["street"]}_P.10', _safe(addr['street']))
            _set_field_ap(f'fill_{F["district"]}_P.10', _safe(addr['district']), fontsize=10)
            _set_field_ap(f'fill_{F["country"]}_P.10', country, fontsize=10)
        _set_text(doc, fmap, 'fill_31_P.10', '2')
        _set_text(doc, fmap, 'fill_32_P.10', str(total_sch1))

    # ── P.10 附表二（上市公司）──
    if is_listed:
        _set_text(doc, fmap, 'fill_1_P.10', day)
        _set_text(doc, fmap, 'fill_2_P.10', month)
        _set_text(doc, fmap, 'fill_3_P.10', year)
        if share_infos:
            _set_text(doc, fmap, 'fill_5_P.10', share_infos[0]['className'])
            _set_text(doc, fmap, 'fill_6_P.10', _fmt_int(share_infos[0]['shares']))

    # ── P.11 續頁A：自然人秘書 #2 ──
    # Always set BR on every page
    _set_text(doc, fmap, 'fill_4_P.11', br8)
    if len(nat_secs) > 1:
        s = nat_secs[1]
        _set_text(doc, fmap, 'fill_1_P.11', day)
        _set_text(doc, fmap, 'fill_2_P.11', month)
        _set_text(doc, fmap, 'fill_3_P.11', year)
        # Names: offset +3 from P.3 (fill_5-7 = fill_2-4 + 3)
        _set_text(doc, fmap, 'fill_5_P.11', s.get('nameChinese', ''))
        surname, other = _parse_english_name(s.get('nameEnglish', ''))
        _set_text(doc, fmap, 'fill_6_P.11', surname)
        _set_text(doc, fmap, 'fill_7_P.11', other)
        addr = _parse_address(s.get('address', ''))
        addr['building'] = ', '.join(filter(None, [addr.pop('block', ''), addr['building']]))
        # Address: offset +3 from P.3 (fill_12-15 = fill_9-12 + 3)
        _set_text(doc, fmap, 'fill_12_P.11', addr['flat'])
        _set_text(doc, fmap, 'fill_13_P.11', addr['building'])
        _set_text(doc, fmap, 'fill_14_P.11', addr['street'])
        _set_field_ap('fill_15_P.11', addr['district'], fontsize=10)
        # P.11 has extra serviceAddress field (fill_16)
        _set_text(doc, fmap, 'fill_16_P.11', s.get('serviceAddress', '') or s.get('address', ''))
        # Email/ID: offset +4 from P.3 (fill_17-19 = fill_13-15 + 4, due to extra fill_16)
        _set_text(doc, fmap, 'fill_17_P.11', s.get('email', ''))
        hkid = _parse_hkid_partial(s.get('idNumber', ''))
        if hkid:
            _set_text(doc, fmap, 'fill_18_P.11', hkid)
        elif s.get('passportNumber'):
            nat = s.get('nationality', '') or s.get('placeIncorporated', '')
            pp = _parse_passport_partial(s['passportNumber'])
            _set_text(doc, fmap, 'fill_19_P.11', f'{nat} / {pp}' if nat else pp)
        tcsp = s.get('tcspNumber', '')
        if tcsp:
            _set_text(doc, fmap, 'fill_21_P.11', tcsp)

    # ── P.12 續頁B：法人秘書 #2 ──
    # Always set BR on every page
    _set_text(doc, fmap, 'fill_4_P.12', br8)
    if len(corp_secs) > 1:
        s = corp_secs[1]
        _set_text(doc, fmap, 'fill_1_P.12', day)
        _set_text(doc, fmap, 'fill_2_P.12', month)
        _set_text(doc, fmap, 'fill_3_P.12', year)
        _set_text(doc, fmap, 'fill_5_P.12', s.get('nameChinese', ''))
        _set_text(doc, fmap, 'fill_6_P.12', s.get('nameEnglish', ''))
        addr = _parse_address(s.get('serviceAddress') or s.get('address', ''))
        addr['building'] = ', '.join(filter(None, [addr.pop('block', ''), addr['building']]))
        _set_text(doc, fmap, 'fill_7_P.12', addr['flat'])
        _set_text(doc, fmap, 'fill_8_P.12', addr['building'])
        _set_text(doc, fmap, 'fill_9_P.12', addr['street'])
        _set_field_ap('fill_10_P.12', addr['district'], fontsize=10)
        _set_text(doc, fmap, 'fill_11_P.12', s.get('email', ''))
        _set_text(doc, fmap, 'fill_12_P.12', s.get('companyNumberRef') or s.get('brNumber', ''))
        tcsp = s.get('tcspNumber', '')
        if tcsp:
            _set_text(doc, fmap, 'fill_13_P.12', tcsp)

    # ── P.13 續頁C：自然人董事 #2 ──
    # Always set BR on every page
    _set_text(doc, fmap, 'fill_4_P.13', br8)
    if len(nat_dirs) > 1:
        d = nat_dirs[1]
        _set_text(doc, fmap, 'fill_1_P.13', day)
        _set_text(doc, fmap, 'fill_2_P.13', month)
        _set_text(doc, fmap, 'fill_3_P.13', year)
        _check(doc, fmap, 'cb_1_P.13', True)
        # Names: offset +3 from P.5 (fill_6-8 = fill_3-5 + 3). fill_5 is former-name (skip)
        _set_field_ap('fill_6_P.13', d.get('nameChinese', ''), fontsize=10, align='center')
        surname, other = _parse_english_name(d.get('nameEnglish', ''))
        _set_text(doc, fmap, 'fill_7_P.13', surname)
        _set_text(doc, fmap, 'fill_8_P.13', other)
        # Address: offset +3 from P.5 (fill_13-17 = fill_10-14 + 3)
        _set_text(doc, fmap, 'fill_13_P.13', office.get('flat', ''))
        _set_text(doc, fmap, 'fill_14_P.13', office.get('building', ''))
        _set_text(doc, fmap, 'fill_15_P.13', office.get('street', ''))
        _set_field_ap('fill_16_P.13', office.get('district', ''), fontsize=10)
        _set_field_ap('fill_17_P.13', office.get('region', ''), fontsize=10)
        # Email/ID: offset +3 from P.5 (fill_18-21 = fill_15-18 + 3)
        _set_text(doc, fmap, 'fill_18_P.13', d.get('email', ''))
        hkid = _parse_hkid_partial(d.get('idNumber', ''))
        if hkid:
            _set_text(doc, fmap, 'fill_19_P.13', hkid)
        elif d.get('passportNumber'):
            _set_text(doc, fmap, 'fill_20_P.13', d.get('nationality', '') or d.get('placeIncorporated', ''))
            _set_text(doc, fmap, 'fill_21_P.13', _parse_passport_partial(d['passportNumber']))

    # ── P.14 續頁D：法人董事 #2+#3 ──
    extra_corp_dirs = corp_dirs[1:]
    # Always set BR on every page
    _set_text(doc, fmap, 'fill_4_P.14', br8)
    if extra_corp_dirs:
        _set_text(doc, fmap, 'fill_1_P.14', day)
        _set_text(doc, fmap, 'fill_2_P.14', month)
        _set_text(doc, fmap, 'fill_3_P.14', year)
        # Slot 1: fields 5-14, checkboxes cb_1, cb_2
        # Slot 2: fields 15-24, checkboxes cb_3, cb_4
        slots_p14 = [
            {'cb_dir': 'cb_1_P.14', 'cb_reserve': 'cb_2_P.14', 'name_cn': 5, 'name_en': 6,
             'flat': 7, 'building': 8, 'street': 9, 'district': 10, 'region': 11,
             'country': 12, 'service_addr': 13, 'email': 14},
            {'cb_dir': 'cb_3_P.14', 'cb_reserve': 'cb_4_P.14', 'name_cn': 15, 'name_en': 16,
             'flat': 17, 'building': 18, 'street': 19, 'district': 20, 'region': 21,
             'country': 22, 'service_addr': 23, 'email': 24},
        ]
        for idx, d in enumerate(extra_corp_dirs[:2]):
            F = slots_p14[idx]
            _check(doc, fmap, F['cb_dir'], True)
            _set_text(doc, fmap, f'fill_{F["name_cn"]}_P.14', d.get('nameChinese', ''))
            _set_text(doc, fmap, f'fill_{F["name_en"]}_P.14', d.get('nameEnglish', ''))
            _set_text(doc, fmap, f'fill_{F["flat"]}_P.14', office.get('flat', ''))
            _set_text(doc, fmap, f'fill_{F["building"]}_P.14', office.get('building', ''))
            _set_text(doc, fmap, f'fill_{F["street"]}_P.14', office.get('street', ''))
            _set_text(doc, fmap, f'fill_{F["district"]}_P.14', office.get('district', ''))
            _set_text(doc, fmap, f'fill_{F["region"]}_P.14', office.get('region', ''))
            _set_text(doc, fmap, f'fill_{F["country"]}_P.14', office.get('region', '香港 Hong Kong'))
            _set_text(doc, fmap, f'fill_{F["email"]}_P.14', d.get('email', ''))

    # ── P.15 續頁E：公司紀錄保存地點 ──
    company_records = data.get('companyRecords') or []
    valid_records = [r for r in company_records if (r.get('records', '') or '').strip() or (r.get('address', '') or '').strip()]
    # Always set BR on every page
    _set_text(doc, fmap, 'fill_4_P.15', br8)
    if valid_records:
        _set_text(doc, fmap, 'fill_1_P.15', day)
        _set_text(doc, fmap, 'fill_2_P.15', month)
        _set_text(doc, fmap, 'fill_3_P.15', year)
        records_text = '\n\n'.join([r.get('records', '') or '' for r in valid_records])
        address_text = '\n\n'.join([r.get('address', '') or '' for r in valid_records])
        _set_text(doc, fmap, 'fill_5_P.15', records_text)
        _set_text(doc, fmap, 'fill_6_P.15', address_text)

    # ── 刪除空白頁（P.16-P.27 無 widget）──
    blank_pages = []
    for pi in range(15, doc.page_count):  # 0-indexed: pages 16-27
        if not list(doc[pi].widgets()):
            blank_pages.append(pi)
    for pi in reversed(blank_pages):
        doc.delete_page(pi)

    # ── 保存 ──
    pdf_bytes = doc.write(deflate=True)
    doc.close()
    return pdf_bytes

@app.route('/api/generate-nar1-pdf', methods=['POST'])
def generate_nar1_pdf():
    try:
        data = request.json
        if not data:
            return jsonify({'error': 'Empty request body'}), 400
        pdf_bytes = _fill_nar1_pdf(data)
        import base64 as b64
        return jsonify({'pdf': b64.b64encode(pdf_bytes).decode('ascii')})
    except Exception as e:
        import traceback
        traceback.print_exc()
        return jsonify({'error': str(e)}), 500

# ─── NR1 PDF 生成（本地 Python + PyMuPDF） ───

def _fill_nr1_pdf(data):
    """填充 NR1 PDF 模板，返回 bytes"""
    template_path = os.path.join(os.path.dirname(__file__), '..', 'public', 'templates', 'NR1-template.pdf')
    doc = fitz.open(template_path)
    fmap = {}
    for pi in range(doc.page_count):
        for w in doc[pi].widgets():
            if w.field_name:
                fmap[w.field_name] = pi

    br8 = re.sub(r'[^0-9A-Za-z]', '', data.get('brNumber', '') or '')[:8]

    # CJK font setup for widget AP (blue editable boxes)
    _tpl_cjk_fontfile = None
    for _sf in ['C:/Windows/Fonts/simhei.ttf', 'C:/Windows/Fonts/simsun.ttc',
                 'C:/Windows/Fonts/msjh.ttc', 'C:/Windows/Fonts/Deng.ttf']:
        if os.path.exists(_sf):
            _tpl_cjk_fontfile = _sf
            break
    _cjk_ap_font_pages = set()
    _cjk_ap_font_xref_map = {}

    def _set_cjk_ap_field(name, value, fontsize=10, align='left', min_fs=6):
        """Fill a single field with blue editable CJK widget AP."""
        if name not in fmap or not value:
            return False
        vstr = str(value)
        pi = fmap[name]
        for w in doc[pi].widgets():
            if w.field_name == name:
                cjk_n = sum(1 for c in vstr if ord(c) > 127)
                asc_n = len(vstr) - cjk_n
                fs = fontsize
                field_w = w.rect.width
                field_h = w.rect.height
                if field_w > 0:
                    usable_w = field_w - 4.0
                    est_w = fs * (cjk_n * 1.0 + asc_n * 0.66)
                    if est_w > usable_w:
                        fs = max(min_fs, int(fs * usable_w / est_w * 0.95))
                if field_h > 0:
                    fs = min(fs, max(min_fs, int(field_h - 3)))
                _set_widget_cjk_ap(doc, doc[pi], w, vstr, fs, _tpl_cjk_fontfile,
                                   _cjk_ap_font_pages, _cjk_ap_font_xref_map,
                                   align=align, valign='bottom')
                return True
        return False

    field_map = {
        'fill_1_P.1': br8,
        'fill_2_P.1': data.get('companyName', ''),
        'fill_3_P.1': data.get('flat', ''),
        'fill_4_P.1': data.get('building', ''),
        'fill_5_P.1': data.get('street', ''),
        'fill_6_P.1': data.get('district', ''),
        'fill_7_P.1': data.get('addressEffectiveDay', ''),
        'fill_8_P.1': data.get('addressEffectiveMonth', ''),
        'fill_9_P.1': data.get('addressEffectiveYear', ''),
        'fill_10_P.1': data.get('email', ''),
        'fill_11_P.1': data.get('emailEffectiveDay', ''),
        'fill_12_P.1': data.get('emailEffectiveMonth', ''),
        'fill_13_P.1': data.get('emailEffectiveYear', ''),
        'fill_14_P.1': data.get('phone', ''),
        'fill_15_P.1': data.get('phoneEffectiveDay', ''),
        'fill_16_P.1': data.get('phoneEffectiveMonth', ''),
        'fill_17_P.1': data.get('phoneEffectiveYear', ''),
        'fill_18_P.1': data.get('signerName', ''),
        'fill_19_P.1': f"{data.get('signDateDay','')}/{data.get('signDateMonth','')}/{data.get('signDateYear','')}",
        'fill_20_P.1': data.get('presentorName', ''),
        'fill_21_P.1': data.get('presentorAddress', ''),
        'fill_22_P.1': data.get('presentorContact', ''),
    }

    # Fields that need special font sizing
    _NR1_BIG_FIELDS = {'fill_21_P.1'}   # presentor address — large field, use bigger font
    _NR1_SHRINK_FIELDS = {'fill_20_P.1'}  # presentor name — shrink to fit if needed

    for name, value in field_map.items():
        if name not in fmap:
            continue
        pi = fmap[name]
        for w in doc[pi].widgets():
            if w.field_name == name:
                try:
                    vstr = str(value) if value else ''
                    if not vstr:
                        break
                    fs = w.text_fontsize if w.text_fontsize and w.text_fontsize > 0 else 10
                    field_w = w.rect.width
                    field_h = w.rect.height
                    if field_w > 0:
                        cjk_n = sum(1 for c in vstr if ord(c) > 127)
                        asc_n = len(vstr) - cjk_n
                        # Big fields: start larger, only shrink if needed
                        if name in _NR1_BIG_FIELDS and field_h > 20:
                            fs = min(field_h - 4, 14)
                            est_w = fs * (cjk_n * 1.0 + asc_n * 0.52)
                            if est_w > field_w:
                                fs = max(9, int(fs * field_w / est_w * 0.95))
                        # Shrink fields: force small font so text stays within widget
                        elif name in _NR1_SHRINK_FIELDS:
                            fs = min(fs, 7)
                            est_w = fs * (cjk_n * 1.0 + asc_n * 0.52)
                            if est_w > field_w:
                                fs = max(5, int(fs * field_w / est_w * 0.95))
                        else:
                            est_w = fs * (cjk_n * 1.0 + asc_n * 0.52)
                            if est_w > field_w:
                                fs = max(6, int(fs * field_w / est_w * 0.95))
                    w.field_value = vstr
                    w.text_fontsize = fs
                    w.update()
                except Exception:
                    pass
                break

    # Re-fill address + email fields with blue editable widget AP (fixes text sinking + CJK rendering)
    if _tpl_cjk_fontfile:
        try:
            for _af_name, _af_val in [('fill_3_P.1', data.get('flat', '')),
                                       ('fill_4_P.1', data.get('building', '')),
                                       ('fill_5_P.1', data.get('street', '')),
                                       ('fill_6_P.1', data.get('district', ''))]:
                _set_cjk_ap_field(_af_name, _af_val, min_fs=12)
            _set_cjk_ap_field('fill_10_P.1', data.get('email', ''), fontsize=12, min_fs=10, align='center')
        except Exception:
            pass  # If CJK widget AP fails, form still has Helv-rendered text from first pass

    # Region dropdown
    region = data.get('region', '')
    if region and 'Dropdown1_P.1' in fmap:
        pi = fmap['Dropdown1_P.1']
        for w in doc[pi].widgets():
            if w.field_name == 'Dropdown1_P.1':
                try:
                    for choice_val, _ in (w.choice_values or []):
                        if choice_val in region or region in choice_val:
                            w.field_value = choice_val
                            w.update()
                            break
                except Exception:
                    pass
                break

    pdf_bytes = doc.write(deflate=True)
    doc.close()
    return pdf_bytes


@app.route('/api/generate-nr1-pdf', methods=['POST'])
def generate_nr1_pdf():
    try:
        data = request.json
        if not data:
            return jsonify({'error': 'Empty request body'}), 400
        pdf_bytes = _fill_nr1_pdf(data)
        import base64 as b64
        return jsonify({'pdf': b64.b64encode(pdf_bytes).decode('ascii')})
    except Exception as e:
        import traceback
        traceback.print_exc()
        return jsonify({'error': str(e)}), 500


# ─── NDR1 PDF 生成（撤銷註冊申請書） ───

def _fill_ndr1_pdf(data):
    """填充 NDR1 PDF 模板，返回 bytes（仿照 NAR1 模式）

    模板实际布局（从 PDF 提取）：
    P.1: BR + 公司名 + 声明勾选 + 申请人资料（中英文名/地址/电话/传真/电邮/参考编号）
    P.2-P.3: 自然人申请人详情（姓名/地址/电邮/传真）
    P.4: 签署人 + 日期 + 日期下拉
    """
    template_path = os.path.join(os.path.dirname(__file__), '..', 'public', 'templates', 'NDR1-template.pdf')
    doc = fitz.open(template_path)
    fmap = _build_field_page_map(doc)

    # Locate a system CJK font for blue widget AP rendering
    _tpl_cjk_fontfile = None
    for _sf in ['C:/Windows/Fonts/simhei.ttf', 'C:/Windows/Fonts/simsun.ttc',
                 'C:/Windows/Fonts/msjh.ttc', 'C:/Windows/Fonts/Deng.ttf']:
        if os.path.exists(_sf):
            _tpl_cjk_fontfile = _sf
            break

    _cjk_ap_font_pages = set()
    _cjk_ap_font_xref_map = {}

    def _set_cjk_ap(name, value, fontsize=10, align='left', valign='bottom', min_fs=6):
        """Fill field with blue editable CJK widget AP. Falls back to _set_text for ASCII."""
        if name not in fmap or not value:
            return False
        vstr = str(value)
        cjk_n = sum(1 for c in vstr if ord(c) > 127)
        if cjk_n == 0 or not _tpl_cjk_fontfile:
            # Pure ASCII or no CJK font — use standard _set_text
            return _set_text(doc, fmap, name, value, min_fs=min_fs, valign=valign)
        pi = fmap[name]
        for w in doc[pi].widgets():
            if w.field_name == name:
                asc_n = len(vstr) - cjk_n
                fs = fontsize
                field_w = w.rect.width
                field_h = w.rect.height
                if field_w > 0:
                    usable_w = field_w - 4.0
                    est_w = fs * (cjk_n * 1.0 + asc_n * 0.66)
                    if est_w > usable_w:
                        fs = max(min_fs, int(fs * usable_w / est_w * 0.95))
                if field_h > 0:
                    fs = min(fs, max(min_fs, int(field_h - 3)))
                _set_widget_cjk_ap(doc, doc[pi], w, vstr, fs, _tpl_cjk_fontfile,
                                   _cjk_ap_font_pages, _cjk_ap_font_xref_map,
                                   align=align, valign=valign)
                return True
        return False

    br8 = re.sub(r'[^0-9A-Za-z]', '', data.get('brNumber', '') or '')[:8]

    # ── P.1: 公司資料 ──
    _set_text(doc, fmap, 'fill_1_P.1', br8)
    _set_text(doc, fmap, 'fill_2_P.1', data.get('companyName', ''), min_fs=7)

    # 聲明勾選
    _check(doc, fmap, 'cb_1_P.1', data.get('noOngoingBusiness'))
    _check(doc, fmap, 'cb_2_P.1', data.get('noOutstandingLiabilities'))
    _check(doc, fmap, 'cb_3_P.1', data.get('noLegalProceedings'))

    # ── P.1 左下角：申請人資料 ──
    # fill_3="Name in Chinese", fill_4="Name in English"(41px高), fill_5+fill_6+fill_7="Address"
    # fill_8="Tel", fill_9="Fax", fill_10="Email", fill_11="Reference"
    _set_cjk_ap('fill_3_P.1', data.get('applicantNameCN', ''), align='left')           # 中文姓名：蓝框左对齐
    _set_text(doc, fmap, 'fill_4_P.1', data.get('applicantNameEN', ''), min_fs=9)
    _set_cjk_ap('fill_5_P.1', data.get('applicantAddress', ''), min_fs=9, valign='bottom')   # 地址1：蓝框
    _set_cjk_ap('fill_6_P.1', data.get('applicantAddress2', ''), min_fs=9, valign='bottom')  # 地址2：蓝框
    _set_cjk_ap('fill_7_P.1', data.get('applicantAddress3', ''), min_fs=9, valign='bottom')  # 地址3：蓝框
    _set_text(doc, fmap, 'fill_8_P.1', data.get('applicantTel', ''))
    _set_text(doc, fmap, 'fill_9_P.1', data.get('applicantFax', ''))
    _set_text(doc, fmap, 'fill_10_P.1', data.get('applicantEmail', ''))
    _set_text(doc, fmap, 'fill_11_P.1', data.get('applicantReference', ''))

    # ── P.4: 簽署人 + 日期 ──
    _set_text(doc, fmap, 'fill_2_P.4', data.get('signerName', ''))
    # fill_3_P.4 = "Date: DD/MM/YYYY", frontend sends YYYY-MM-DD
    sign_date = data.get('signDate', '')
    if sign_date and '-' in sign_date:
        parts = sign_date.split('-')
        sign_date = f'{parts[2]}/{parts[1]}/{parts[0]}'  # YYYY-MM-DD → DD/MM/YYYY
    elif not sign_date:
        dd = data.get('signDateDay', '')
        mm = data.get('signDateMonth', '')
        yy = data.get('signDateYear', '')
        if dd and mm and yy:
            sign_date = f'{dd}/{mm}/{yy}'
    _set_text(doc, fmap, 'fill_3_P.4', sign_date)

    # ── P.2-P.3: 自然人申请人详情（选人后自动填入）──
    person = data.get('selectedPerson')
    if person:
        cn = person.get('nameChinese', '')
        en = person.get('nameEnglish', '')
        surname, other = _parse_english_name(en) if en else ('', '')
        address = person.get('address', '')
        flat = person.get('addrFlat', '')
        building = person.get('addrBuilding', '')
        street = person.get('addrStreet', '')
        district = person.get('addrDistrict', '')
        region = person.get('addrRegion', '')
        email = person.get('email', '')
        tel = person.get('phone', '')

        # P.2: 第1位自然人申请人
        _set_text(doc, fmap, 'fill_1_P.2', br8)
        _set_cjk_ap('fill_2_P.2', cn, align='center')   # 中文姓名：蓝框居中
        _set_text(doc, fmap, 'fill_3_P.2', surname)
        _set_text(doc, fmap, 'fill_4_P.2', other)
        # Parse address if individual fields are empty
        if not any([flat, building, street, district, region]) and address:
            parsed = _parse_address(address)
            flat = flat or parsed.get('flat', '')
            building = building or parsed.get('building', '') or parsed.get('block', '')
            street = street or parsed.get('street', '')
            district = district or parsed.get('district', '')
            region = region or parsed.get('country', '')
        _set_text(doc, fmap, 'fill_6_P.2', flat, valign='top')
        _set_text(doc, fmap, 'fill_7_P.2', building, valign='top')
        _set_text(doc, fmap, 'fill_8_P.2', street, valign='top')
        _set_text(doc, fmap, 'fill_9_P.2', district, valign='top')
        _set_text(doc, fmap, 'fill_10_P.2', region, valign='top')
        _set_text(doc, fmap, 'fill_11_P.2', email)
        if tel:
            _set_text(doc, fmap, 'fill_12_P.2', tel)

    # BR on all pages
    _stamp_br_on_all_pages(doc, br8)

    pdf_bytes = doc.write(deflate=True)
    doc.close()
    return pdf_bytes


@app.route('/api/generate-ndr1-pdf', methods=['POST'])
def generate_ndr1_pdf():
    try:
        data = request.json
        if not data:
            return jsonify({'error': 'Empty request body'}), 400
        pdf_bytes = _fill_ndr1_pdf(data)
        import base64 as b64
        return jsonify({'pdf': b64.b64encode(pdf_bytes).decode('ascii')})
    except Exception as e:
        import traceback
        traceback.print_exc()
        return jsonify({'error': str(e)}), 500




def _fill_nd2a_pdf(data, template='ND2A-template.pdf'):
    """Fill ND2A/NN6 PDF template using PyMuPDF"""
    template_path = os.path.join(os.path.dirname(__file__), '..', 'public', 'templates', template)
    doc = fitz.open(template_path)
    fmap = {}
    for pi in range(doc.page_count):
        for w in doc[pi].widgets():
            if w.field_name:
                fmap[w.field_name] = pi

    # ── Fill helpers ──
    # For all fields: w.field_value + w.update() (generates valid AP)
    # For CJK fields: additionally overlay with system CJK font + hide widget (F=3)
    #   because w.update() hardcodes Helv which can't render CJK glyphs
    _cjk_overlays = []  # (page_idx, rect, value, fontsize, annot_xref)
    _all_attempted_fields = []     # track for warnings
    _all_attempted_checkboxes = []  # track for warnings
    _CKJ_AP_PAGES = set()           # pages with widget AP CJK font embedded
    _CKJ_AP_FONT_XREF_MAP = {}      # page → font PDF xref

    # Resolve system CJK font once
    _sys_fonts = [
        'C:/Windows/Fonts/simhei.ttf',   # ~10MB, good CJK coverage
        'C:/Windows/Fonts/simsun.ttc',   # fallback
        'C:/Windows/Fonts/msjh.ttc',     # fallback (~21MB)
        'C:/Windows/Fonts/Deng.ttf',     # last resort
    ]
    _cjk_fontfile = None
    for _sf in _sys_fonts:
        if os.path.exists(_sf):
            _cjk_fontfile = _sf
            break

    def _set(name, value, min_fs=6, align='left', use_ap=False):
        _all_attempted_fields.append(name)
        if name not in fmap or not value:
            return
        vstr = str(value)
        pi = fmap[name]
        for w in doc[pi].widgets():
            if w.field_name == name:
                has_cjk = any(ord(c) > 127 for c in vstr)
                # Adaptive font size based on available field width.
                fs = w.text_fontsize if w.text_fontsize and w.text_fontsize > 0 else 10
                field_w = w.rect.width
                field_h = w.rect.height
                usable_w = field_w - 3.0 if has_cjk else field_w
                # Estimate rendered width: CJK font ≈ 1.0×fs, Helv ASCII ≈ 0.66×fs
                cjk_n = sum(1 for c in vstr if ord(c) > 127)
                asc_n = len(vstr) - cjk_n
                est_w = fs * (cjk_n * 1.0 + asc_n * 0.66)
                if usable_w > 0 and est_w > usable_w:
                    fs = max(min_fs, int(fs * usable_w / est_w * 0.95))
                if field_h > 0:
                    fs = min(fs, max(min_fs, int(field_h - 2)))
                if use_ap and _cjk_fontfile:
                    # Force widget AP (blue editable box) — for address etc.
                    # NOTE: _CKJ_AP_PAGES is managed by _set_widget_cjk_ap internally;
                    # adding pi here prematurely would cause font embedding to be skipped.
                    _set_widget_cjk_ap(
                        doc, doc[pi], w, vstr, fs,
                        _cjk_fontfile, _CKJ_AP_PAGES,
                        _CKJ_AP_FONT_XREF_MAP, align='left', valign='top')
                elif align == 'center' and _cjk_fontfile:
                    # Use widget AP with center alignment (blue editable box)
                    _set_widget_cjk_ap(
                        doc, doc[pi], w, vstr, fs,
                        _cjk_fontfile, _CKJ_AP_PAGES,
                        _CKJ_AP_FONT_XREF_MAP, align='center', valign='center')
                elif has_cjk and _cjk_fontfile:
                    # Legacy: overlay CJK on page content, hide widget
                    try:
                        w.field_value = vstr
                        w.text_fontsize = fs
                        w.update()
                    except Exception:
                        pass
                    _cjk_overlays.append((pi, w.rect, vstr, fs, w._annot.xref))
                else:
                    try:
                        w.field_value = vstr
                        w.text_fontsize = fs
                        w.update()
                    except Exception:
                        pass
                break

    def _check(name):
        _all_attempted_checkboxes.append(name)
        if name not in fmap:
            return
        pi = fmap[name]
        for w in doc[pi].widgets():
            if w.field_name == name:
                try:
                    w.field_value = True
                    w.update()
                except Exception:
                    pass
                break

    _cjk_fontname = None  # set once when font is first embedded

    def _apply_cjk_overlays():
        """Overlay CJK text on each page using system CJK font, then hide the
        original Helv-rendered widgets (F=3).

        IMPORTANT: PyMuPDF 1.28 insert_textbox(fontfile=...) does NOT embed the
        font in the PDF (bug), making CJK characters invisible. Workaround:
        page.insert_font() to pre-embed, then insert_textbox(fontname=...)."""
        nonlocal _cjk_fontname
        if not _cjk_overlays or not _cjk_fontfile:
            return
        _cjk_fontname = 'CJK'
        _font_pages = set()
        for pi, rect, value, fontsize, annot_xref in _cjk_overlays:
            try:
                doc[pi].clean_contents()
            except Exception:
                pass
            try:
                # Embed CJK font on this page (once per page)
                if pi not in _font_pages:
                    doc[pi].insert_font(fontname=_cjk_fontname, fontfile=_cjk_fontfile)
                    _font_pages.add(pi)
                inset = 1.5
                text_rect = fitz.Rect(
                    rect.x0 + inset, rect.y0 + inset,
                    rect.x1 - inset, rect.y1 - inset
                )
                doc[pi].insert_textbox(
                    text_rect,
                    value,
                    fontname=_cjk_fontname,
                    fontsize=fontsize,
                    color=(0, 0, 0),
                )
                doc.xref_set_key(annot_xref, 'F', '3')
            except Exception:
                pass

    br8 = re.sub(r'[^0-9A-Za-z]', '', data.get('brNumber', '') or '')[:8]

    is_nn6 = 'NN6' in template

    # P.1: Company info
    _set('fill_1_P.1', br8)
    _set('fill_2_P.1', data.get('companyName', ''))

    # Set BR on every page that has a BR widget (P.2-P.7 etc.)
    for pi in range(2, doc.page_count + 1):
        br_field = f'fill_1_P.{pi}'
        if br_field in fmap:
            _set(br_field, br8)

    officers = data.get('officers') or []

    if is_nn6:
        # ── NN6 P.1: first officer is on P.1, not a continuation sheet ──
        # P.1 natural-person fields:
        #   fill_3 → 代替 Alternate to (alternate director only)
        #   fill_4 → 中文姓名 Name in Chinese
        #   fill_5 → 英文姓氏 Surname
        #   fill_6 → 英文名字 Other Names
        #   fill_7 → 身分識別 HKID partial (narrow left)
        #   fill_8 → 護照 Passport partial (wider right)
        # P.1 body-corporate fields:
        #   fill_9 → 中文名稱 Name in Chinese
        #   fill_10 → 英文名稱 Name in English
        # P.1 cessation date: fill_11/12/13 (D/M/Y) — same as ND2A
        # P.1 presentor:
        #   fill_14 → 姓名／名稱 Name (NOT contact!)
        #   fill_15 → 地址 Address
        #   fill_16 → 電話 Tel
        #   fill_17 → 傳真 Fax
        #   fill_18 → 電郵 Email
        #   fill_19 → 檔號 Reference
        if officers:
            officer = officers[0]
            is_cessation = officer.get('type') == 'cessation'
            # ── 委任(appointment)：P.1 寫基本姓名+證件（詳細資料在 P.2/P.3） ──
            # ── 停任(cessation)：P.1 只寫日期+勾選（詳細資料在續頁A P.4/P.5） ──
            if not is_cessation:
                if officer.get('identity') == 'natural':
                    _set('fill_4_P.1', officer.get('nameChinese', ''), align='center')
                    en_name = officer.get('nameEnglish', '')
                    if officer.get('nameSurname') or officer.get('nameOtherNames'):
                        _set('fill_5_P.1', officer.get('nameSurname', ''))
                        _set('fill_6_P.1', officer.get('nameOtherNames', ''))
                    else:
                        surname, other = _parse_english_name(en_name)
                        _set('fill_5_P.1', surname)
                        _set('fill_6_P.1', other)
                    _set('fill_7_P.1', (officer.get('idNumber', '') or '')[:4])
                    _set('fill_8_P.1', (officer.get('passportNumber', '') or '')[:8])
                else:
                    _set('fill_9_P.1', officer.get('nameChinese', ''), align='center')
                    _set('fill_10_P.1', officer.get('companyName', officer.get('nameEnglish', '')))
            # Checkboxes (P.1) — role
            if officer.get('role') == 'secretary':
                _check('cb_1_P.1')
            else:
                _check('cb_2_P.1')
            # Cessation/appointment
            if is_cessation:
                _check('cb_4_P.1')
            else:
                _check('cb_3_P.1')
            # Date (cessation or appointment) → fill_11/12/13
            date_str = officer.get('dateCeased') or officer.get('dateAppointed')
            if date_str:
                parts = date_str.split('-')
                if len(parts) >= 3:
                    _set('fill_11_P.1', parts[2])  # day
                    _set('fill_12_P.1', parts[1])  # month
                    _set('fill_13_P.1', parts[0])  # year
        # NN6 presentor fields — DIFFERENT from ND2A!
        _set('fill_14_P.1', data.get('presentorName', ''))
        _set('fill_15_P.1', data.get('presentorAddress', ''), min_fs=9)
        # Presentor contact — use separate fields (fallback to old combined presentorContact)
        _set('fill_16_P.1', data.get('presentorPhone', ''))
        _set('fill_17_P.1', data.get('presentorFax', ''))
        _set('fill_18_P.1', data.get('presentorEmail', ''))
        _set('fill_19_P.1', data.get('presentorReference', ''))
        # Fallback: old combined presentorContact field
        pcontact = data.get('presentorContact', '')
        if pcontact and not data.get('presentorPhone') and not data.get('presentorEmail'):
            parts_contact = [c.strip() for c in pcontact.replace('\n', '/').split('/')]
            if len(parts_contact) >= 3:
                _set('fill_16_P.1', parts_contact[0])
                _set('fill_17_P.1', parts_contact[1])
                _set('fill_18_P.1', parts_contact[2])
            elif len(parts_contact) == 2:
                _set('fill_16_P.1', parts_contact[0])
                _set('fill_18_P.1', parts_contact[1])
            else:
                _set('fill_18_P.1', pcontact)
        # Signer name: NN6 P.1 has no separate signer-name field (it's part of presentor)
        # Use signerName in fill_14 if presentorName is empty
        if not data.get('presentorName') and data.get('signerName'):
            _set('fill_14_P.1', data.get('signerName', ''))

        # ── NN6 continuation sheets ──
        # P.2 (natural): FULL details — Chinese name, English surname/other,
        #   former names (中/英), alias (中/英), structured address, email,
        #   HKID, passport country+number, appointment date, role, alreadyDirector
        # P.3 (corporate): FULL details — Chinese/English name, registered office,
        #   structured correspondence address, appointment date, role, alreadyDirector
        # P.4/P.5 停任續頁A（自然人→P.4, 法人→P.5）
        # P.6/P.7 停任續頁B（第2+位停任）
        for i, officer in enumerate(officers[:3]):
            is_nat = officer.get('identity') == 'natural'
            is_cessation = officer.get('type') == 'cessation'

            if is_cessation:
                # 停任 → 自然人P.4/P.6, 法人P.5/P.7
                p = 4 + (i * 2) if is_nat else 5 + (i * 2)
            else:
                # 委任 → 自然人P.2/P.4/P.6, 法人P.3/P.5/P.7
                p = (i * 2) + 2
                if not is_nat:
                    p = (i * 2) + 3

            if p == 2 and is_nat and not is_cessation:
                # ═══ P.2 自然人詳細資料（第一續頁） ═══
                # 中文姓名（藍框+居中）
                _set('fill_3_P.2', officer.get('nameChinese', ''), align='center')
                # 英文姓氏 + 英文名字
                en_name = officer.get('nameEnglish', '')
                if officer.get('nameSurname') or officer.get('nameOtherNames'):
                    _set('fill_4_P.2', officer.get('nameSurname', ''))
                    _set('fill_5_P.2', officer.get('nameOtherNames', ''))
                else:
                    surname, other = _parse_english_name(en_name)
                    _set('fill_4_P.2', surname)
                    _set('fill_5_P.2', other)
                # 前用姓名
                if officer.get('hasFormerName'):
                    _set('fill_6_P.2', officer.get('formerNameChinese', ''), align='center')
                    _set('fill_7_P.2', officer.get('formerNameEnglish', ''))
                # 別名
                if officer.get('hasAlias'):
                    _set('fill_8_P.2', officer.get('aliasChinese', ''), align='center')
                    _set('fill_9_P.2', officer.get('aliasEnglish', ''))
                # 通訊地址（結構化：室/樓/座 → 大廈 → 街道 → 區/市 → 國家/地區）
                _set('fill_10_P.2', officer.get('addrFlatBlock', ''), use_ap=True)
                _set('fill_11_P.2', officer.get('addrBuilding', ''), use_ap=True)
                _set('fill_12_P.2', officer.get('addrStreetEstate', ''), use_ap=True)
                _set('fill_13_P.2', officer.get('addrDistrict', ''), use_ap=True)
                _set('fill_14_P.2', officer.get('addrRegion', ''), use_ap=True)
                # 電郵地址
                _set('fill_15_P.2', officer.get('email', ''))
                # 香港身份證
                _set('fill_16_P.2', officer.get('idNumber', ''))
                # 護照（簽發國家 + 號碼）
                _set('fill_17_P.2', officer.get('passportCountry', ''), use_ap=True)
                _set('fill_18_P.2', officer.get('passportNumber', ''))
                # 委任／停任日期（日/月/年）
                date_str = officer.get('dateAppointed') or officer.get('dateCeased')
                if date_str:
                    parts = date_str.split('-')
                    if len(parts) >= 3:
                        _set('fill_19_P.2', parts[2])  # 日
                        _set('fill_20_P.2', parts[1])  # 月
                        _set('fill_21_P.2', parts[0])  # 年
                # 身份（秘書/董事/候補董事）
                role_map = {'secretary': '1', 'director': '2', 'alternate': '3'}
                _check(f'cb_{role_map.get(officer.get("role", ""), "2")}_P.2')
                if officer.get('role') == 'alternate':
                    _set('fill_2_P.2', officer.get('alternateTo', ''))
                # 上述董事或候補董事在獲得這次委任時，是否已經是這公司的現任候補董事或董事？
                if officer.get('alreadyDirector') == 'yes':
                    _check('cb_4_P.2')   # 是
                elif officer.get('alreadyDirector') == 'no':
                    _check('cb_5_P.2')   # 否

            elif p == 3 and not is_nat and not is_cessation:
                # ═══ P.3 法人團體詳細資料（第一續頁） ═══
                # 中文名稱（藍框+居中）
                _set('fill_3_P.3', officer.get('nameChinese', ''), align='center')
                # 英文名稱
                _set('fill_4_P.3', officer.get('companyName', officer.get('nameEnglish', '')))
                # 通訊地址（結構化；fill_5 原為註冊辦事處地址，現改用樓/室）
                _set('fill_5_P.3', officer.get('addrFlatBlock', ''), use_ap=True)
                _set('fill_6_P.3', officer.get('addrBuilding', ''), use_ap=True)
                _set('fill_7_P.3', officer.get('addrStreetEstate', ''), use_ap=True)
                _set('fill_8_P.3', officer.get('addrDistrict', ''), use_ap=True)
                _set('fill_9_P.3', officer.get('addrRegion', ''), use_ap=True)
                # 電郵
                _set('fill_10_P.3', officer.get('email', ''))
                # 商業登記號碼
                _set('fill_11_P.3', officer.get('companyNumber', ''))
                # 委任日期（日/月/年）
                date_str = officer.get('dateAppointed') or officer.get('dateCeased')
                if date_str:
                    parts = date_str.split('-')
                    if len(parts) >= 3:
                        _set('fill_12_P.3', parts[2])  # 日
                        _set('fill_13_P.3', parts[1])  # 月
                        _set('fill_14_P.3', parts[0])  # 年
                # 身份（秘書/董事/候補董事）
                role_map = {'secretary': '1', 'director': '2', 'alternate': '3'}
                _check(f'cb_{role_map.get(officer.get("role", ""), "2")}_P.3')
                # 是否已經是現任董事？
                if officer.get('alreadyDirector') == 'yes':
                    _check('cb_4_P.3')   # 是
                elif officer.get('alreadyDirector') == 'no':
                    _check('cb_5_P.3')   # 否
                # 簽署人姓名（P.3 底部，藍框居中）
                _set('fill_19_P.3', officer.get('corpSignerName', ''), use_ap=True, align='center')
                # 簽署日期（P.3 底部右側）
                sign_date = officer.get('corpSignDate', '')
                if sign_date:
                    _set('fill_20_P.3', sign_date, use_ap=True)

                # 續頁頁數（P.3 底部 fill_15/16/17）
                # 統計停任產生的續頁：自然人→P.4, 法人→P.5
                cont_a = cont_b = cont_c = 0
                if officer.get('hasCessation') and officer.get('dateCeased'):
                    cont_a = 1  # 續頁A (P.4 或 P.5)
                # 檢查後續 officer 是否還有續頁
                for j in range(i + 1, min(len(officers), 3)):
                    oj = officers[j]
                    if oj.get('type') == 'cessation' or (oj.get('hasCessation') and oj.get('dateCeased')):
                        cont_b += 1  # 續頁B
                if cont_a: _set('fill_15_P.3', str(cont_a), use_ap=True, align='center')
                if cont_b: _set('fill_16_P.3', str(cont_b), use_ap=True, align='center')
                if cont_c: _set('fill_17_P.3', str(cont_c), use_ap=True, align='center')

                # ═══ 法人委任同時含停任操作 → P.4(自然人)/P.5(法人) 停任續頁 ═══
                if officer.get('hasCessation') and officer.get('dateCeased'):
                    cess_id = officer.get('cessationIdentity', 'natural')
                    cess_role = officer.get('cessationRole', officer.get('role', 'director'))
                    if cess_id == 'natural':
                        # ── P.4 自然人停任 ──
                        _set('fill_3_P.4', officer.get('cessationNameChinese', ''), align='center')
                        en_name = officer.get('cessationNameEnglish', '')
                        if officer.get('cessationNameSurname') or officer.get('cessationNameOtherNames'):
                            _set('fill_4_P.4', officer.get('cessationNameSurname', ''))
                            _set('fill_5_P.4', officer.get('cessationNameOtherNames', ''))
                        else:
                            surname, other = _parse_english_name(en_name)
                            _set('fill_4_P.4', surname)
                            _set('fill_5_P.4', other)
                        _set('fill_6_P.4', officer.get('cessationIdNumber', ''))
                        _set('fill_7_P.4', officer.get('cessationPassportNumber', ''))
                        # 停任日期
                        parts = officer.get('dateCeased', '').split('-')
                        if len(parts) >= 3:
                            _set('fill_10_P.4', parts[2])  # 日
                            _set('fill_11_P.4', parts[1])  # 月
                            _set('fill_12_P.4', parts[0])  # 年
                        # 身份
                        role_map = {'secretary': '1', 'director': '2', 'alternate': '3'}
                        _check(f'cb_{role_map.get(cess_role, "2")}_P.4')
                        # 是否現任董事
                        if officer.get('cessationAlreadyDirector') == 'yes':
                            _check('cb_4_P.4')
                        elif officer.get('cessationAlreadyDirector') == 'no':
                            _check('cb_5_P.4')
                    else:
                        # ── P.5 法人停任 ──
                        _set('fill_3_P.5', officer.get('cessationNameEnglish', officer.get('companyName', officer.get('nameEnglish', ''))))
                        _set('fill_4_P.5', officer.get('cessationNameChinese', officer.get('nameChinese', '')), align='center')
                        _set('fill_5_P.5', officer.get('companyNumber', ''))
                        # 停任日期
                        parts = officer.get('dateCeased', '').split('-')
                        if len(parts) >= 3:
                            _set('fill_11_P.5', parts[2])  # 日
                            _set('fill_12_P.5', parts[1])  # 月
                            _set('fill_13_P.5', parts[0])  # 年
                        # 身份
                        role_map = {'secretary': '1', 'director': '2', 'alternate': '3'}
                        _check(f'cb_{role_map.get(cess_role, "2")}_P.5')
                        # 是否現任董事
                        if officer.get('cessationAlreadyDirector') == 'yes':
                            _check('cb_4_P.5')
                        elif officer.get('cessationAlreadyDirector') == 'no':
                            _check('cb_5_P.5')

            elif p == 4 and is_nat and is_cessation:
                # ═══ P.4 自然人停任（續頁A） ═══
                # Template: fill_3=中文姓名, fill_4=英文姓氏, fill_5=英文名字
                #   fill_6=HKID, fill_7=護照號碼
                #   fill_8=地址行1(高), fill_9=地址行2(高)
                #   fill_10/11/12=D/M/Y
                _set('fill_3_P.4', officer.get('nameChinese', ''), align='center')
                en_name = officer.get('nameEnglish', '')
                if officer.get('nameSurname') or officer.get('nameOtherNames'):
                    _set('fill_4_P.4', officer.get('nameSurname', ''))
                    _set('fill_5_P.4', officer.get('nameOtherNames', ''))
                else:
                    surname, other = _parse_english_name(en_name)
                    _set('fill_4_P.4', surname)
                    _set('fill_5_P.4', other)
                _set('fill_6_P.4', officer.get('idNumber', ''))
                _set('fill_7_P.4', officer.get('passportNumber', ''))
                # 地址：兩行高欄位
                addr_fb = officer.get('addrFlatBlock', '')
                addr_bld = officer.get('addrBuilding', '')
                addr_se = officer.get('addrStreetEstate', '')
                addr_dist = officer.get('addrDistrict', '')
                addr_reg = officer.get('addrRegion', '')
                has_structured = any([addr_fb, addr_bld, addr_se, addr_dist, addr_reg])
                if has_structured:
                    line1 = ', '.join(filter(None, [addr_fb, addr_bld, addr_se]))
                    line2 = ', '.join(filter(None, [addr_dist, addr_reg]))
                    _set('fill_8_P.4', line1, use_ap=True)
                    _set('fill_9_P.4', line2, use_ap=True)
                else:
                    _set('fill_8_P.4', officer.get('address', ''), use_ap=True)
                # 停任日期
                date_str = officer.get('dateCeased') or officer.get('dateAppointed')
                if date_str:
                    parts = date_str.split('-')
                    if len(parts) >= 3:
                        _set('fill_10_P.4', parts[2])  # 日
                        _set('fill_11_P.4', parts[1])  # 月
                        _set('fill_12_P.4', parts[0])  # 年
                # 身份
                role_map = {'secretary': '1', 'director': '2', 'alternate': '3'}
                _check(f'cb_{role_map.get(officer.get("role", ""), "2")}_P.4')

            elif p == 5 and not is_nat and is_cessation:
                # ═══ P.5 法人停任（續頁A） ═══
                _set('fill_3_P.5', officer.get('companyName', officer.get('nameEnglish', '')))
                _set('fill_4_P.5', officer.get('nameChinese', ''), align='center')
                _set('fill_5_P.5', officer.get('companyNumber', ''))
                _set('fill_6_P.5', officer.get('placeIncorporated', ''))
                _set('fill_7_P.5', officer.get('address', ''), use_ap=True)
                role_map = {'secretary': '1', 'director': '2', 'alternate': '3'}
                _check(f'cb_{role_map.get(officer.get("role", ""), "2")}_P.5')

            elif is_nat:
                # ═══ P.4/P.6 自然人簡化續頁 ═══
                _NATURAL_SIMPLE = {
                    4: (3, 4, 5, 6, (10, 11, 12)),   # P.4: cn=3, surname=4, other=5, hkid=6, D/M/Y=10/11/12
                    6: (3, 4, 0, 0, (12, 13, 14)),   # P.6: cn=3, en_full=4, no hkid, D/M/Y=12/13/14
                }
                ns = _NATURAL_SIMPLE.get(p)
                if ns:
                    cn_fill, sn_fill, ot_fill, hkid_fill, (d_fill, m_fill, y_fill) = ns
                    _set(f'fill_{cn_fill}_P.{p}', officer.get('nameChinese', ''), align='center')
                    en_name = officer.get('nameEnglish', '')
                    if ot_fill:
                        surname, other = _parse_english_name(en_name)
                        _set(f'fill_{sn_fill}_P.{p}', surname)
                        _set(f'fill_{ot_fill}_P.{p}', other)
                    elif sn_fill:
                        _set(f'fill_{sn_fill}_P.{p}', en_name)
                    if hkid_fill:
                        _set(f'fill_{hkid_fill}_P.{p}', officer.get('idNumber', ''))
                    # Address
                    addr_fb6 = officer.get('addrFlatBlock', '')
                    addr_bld6 = officer.get('addrBuilding', '')
                    addr_se6 = officer.get('addrStreetEstate', '')
                    addr_dist6 = officer.get('addrDistrict', '')
                    addr_reg6 = officer.get('addrRegion', '')
                    has_structured6 = any([addr_fb6, addr_bld6, addr_se6, addr_dist6, addr_reg6])
                    if p == 4:
                        if has_structured6:
                            line1 = ', '.join(filter(None, [addr_fb6, addr_bld6, addr_se6]))
                            line2 = ', '.join(filter(None, [addr_dist6, addr_reg6]))
                            _set('fill_8_P.4', line1, use_ap=True)
                            _set('fill_9_P.4', line2, use_ap=True)
                        else:
                            _set('fill_8_P.4', officer.get('address', ''), use_ap=True)
                    elif p == 6:
                        if has_structured6:
                            _set('fill_5_P.6', addr_fb6, use_ap=True)
                            _set('fill_6_P.6', addr_bld6, use_ap=True)
                            _set('fill_7_P.6', addr_se6, use_ap=True)
                            _set('fill_8_P.6', addr_dist6, use_ap=True)
                            _set('fill_9_P.6', addr_reg6, use_ap=True)
                        else:
                            _set('fill_5_P.6', officer.get('address', ''), use_ap=True)
                    # Date
                    date_str = officer.get('dateAppointed') or officer.get('dateCeased')
                    if date_str:
                        parts = date_str.split('-')
                        if len(parts) >= 3:
                            _set(f'fill_{d_fill}_P.{p}', parts[2])
                            _set(f'fill_{m_fill}_P.{p}', parts[1])
                            _set(f'fill_{y_fill}_P.{p}', parts[0])
                role_map = {'secretary': '1', 'director': '2', 'alternate': '3'}
                _check(f'cb_{role_map.get(officer.get("role", ""), "2")}_P.{p}')

            else:
                # ═══ P.5/P.7 法人簡化續頁 ═══
                _set(f'fill_3_P.{p}', officer.get('companyName', officer.get('nameEnglish', '')))
                _set(f'fill_5_P.{p}', officer.get('companyNumber', ''))
                _set(f'fill_6_P.{p}', officer.get('placeIncorporated', ''))
                _set(f'fill_7_P.{p}', officer.get('address', ''))
                role_map = {'secretary': '1', 'director': '2', 'alternate': '3'}
                _check(f'cb_{role_map.get(officer.get("role", ""), "2")}_P.{p}')
    else:
        # ── ND2A: first officer on P.2 (continuation sheet) ──
        # Per-page field mapping for natural-person pages.
        # Each continuation sheet (P.2/P.4/P.6) has a fundamentally different field
        # layout — we can NOT reuse the same field numbers across pages.
        #
        # Mapping tuple: (cn_name, en_surname, en_other, hkid, addr, (D,M,Y))
        #   en_other=0  → en_surname is a full-name field (not split)
        #   hkid=0      → no HKID field on this page
        _NATURAL_MAP = {
            2: (3,  4,  5,  16, 10, (21, 22, 23)),  # P.2: cn=3, surname=4, other=5, hkid=16, addr=10
            4: (3,  4,  5,   7,  8, (10, 11, 12)),  # P.4: cn=3, surname=4, other=5, hkid=7,  addr=8
            6: (3,  4,  0,   0,  5, (14, 15, 16)),  # P.6: cn=3, en_full=4, no hkid, addr=5
        }
        for i, officer in enumerate(officers[:3]):
            is_natural = officer.get('identity') == 'natural'
            page = (i * 2) + 2  # natural: P.2, P.4, P.6; corporate: P.3, P.5, P.7
            if not is_natural:
                page = (i * 2) + 3
            p = page
            if is_natural:
                cn_fill, sn_fill, ot_fill, hkid_fill, addr_fill, (d_fill, m_fill, y_fill) = \
                    _NATURAL_MAP.get(p, (3, 4, 5, 7, 8, (9, 10, 11)))
                _set(f'fill_{cn_fill}_P.{p}', officer.get('nameChinese', ''), align='center')
                en_name = officer.get('nameEnglish', '')
                if ot_fill:
                    surname, other = _parse_english_name(en_name)
                    _set(f'fill_{sn_fill}_P.{p}', surname)
                    _set(f'fill_{ot_fill}_P.{p}', other)
                elif sn_fill:
                    _set(f'fill_{sn_fill}_P.{p}', en_name)
                if hkid_fill:
                    _set(f'fill_{hkid_fill}_P.{p}', officer.get('idNumber', ''))
                # Address — use individual fields (addrFlatBlock/addrBuilding/...) if provided, else parse
                addr_fb = officer.get('addrFlatBlock', '')
                addr_bld = officer.get('addrBuilding', '')
                addr_se = officer.get('addrStreetEstate', '')
                addr_dist = officer.get('addrDistrict', '')
                addr_reg = officer.get('addrRegion', '')
                has_structured = any([addr_fb, addr_bld, addr_se, addr_dist, addr_reg])
                if has_structured:
                    # Per-page address field mappings (all use_ap=True for blue editable box)
                    _ADDR_MAP = {
                        2: {'fb': 10, 'bld': 11, 'se': 12, 'dist': 13, 'reg': 14},
                        4: None,  # P.4 has 2 tall fields → combine into lines below
                        6: {'fb': 5, 'bld': 6, 'se': 7, 'dist': 8, 'reg': 9},
                    }
                    am = _ADDR_MAP.get(p)
                    if am:
                        _set(f'fill_{am["fb"]}_P.{p}', addr_fb, use_ap=True)
                        _set(f'fill_{am["bld"]}_P.{p}', addr_bld, use_ap=True)
                        _set(f'fill_{am["se"]}_P.{p}', addr_se, use_ap=True)
                        _set(f'fill_{am["dist"]}_P.{p}', addr_dist, use_ap=True)
                        _set(f'fill_{am["reg"]}_P.{p}', addr_reg, use_ap=True)
                    elif p == 4:
                        # P.4: fill_8,9 are tall fields → 2 lines
                        line1 = ', '.join(filter(None, [addr_fb, addr_bld, addr_se]))
                        line2 = ', '.join(filter(None, [addr_dist, addr_reg]))
                        _set(f'fill_8_P.4', line1, use_ap=True)
                        _set(f'fill_9_P.4', line2, use_ap=True)
                else:
                    _set(f'fill_{addr_fill}_P.{p}', officer.get('address', ''), use_ap=True)
                date_str = officer.get('dateAppointed') or officer.get('dateCeased')
                if date_str:
                    parts = date_str.split('-')
                    if len(parts) >= 3:
                        _set(f'fill_{d_fill}_P.{p}', parts[2])
                        _set(f'fill_{m_fill}_P.{p}', parts[1])
                        _set(f'fill_{y_fill}_P.{p}', parts[0])
                _check(f'cb_{"1" if officer.get("role") == "secretary" else "2"}_P.{p}')
                _check(f'cb_{"3" if officer.get("type") == "appointment" else "4"}_P.{p}')
            else:
                _set(f'fill_3_P.{p}', officer.get('companyName', officer.get('nameEnglish', '')))
                _set(f'fill_5_P.{p}', officer.get('companyNumber', ''))
                _set(f'fill_6_P.{p}', officer.get('placeIncorporated', ''))
                _set(f'fill_7_P.{p}', officer.get('address', ''))
                _check(f'cb_{"1" if officer.get("role") == "secretary" else "2"}_P.{p}')
                _check(f'cb_{"3" if officer.get("type") == "appointment" else "4"}_P.{p}')

        # ── ND2A P.1 presentor section (bottom of page 1) ──
        # From extracted template text labels:
        #   fill_14 = "姓名／名稱 Name" (h=14, single line)
        #   fill_15 = "地址 Address" (h=44, multi-line)
        #   fill_16 = "電話 Tel"    fill_17 = "傳真 Fax"
        #   fill_18 = "電郵 Email"  fill_19 = "檔號 Reference"
        # NOTE: fill_9/fill_10 at y=492,531 are body-corporate name fields
        # in Section A ("中文名稱"/"英文名稱"), NOT signer/presentor!
        presentor_name = data.get('presentorName', '') or data.get('signerName', '')
        _set('fill_14_P.1', presentor_name)
        _set('fill_15_P.1', data.get('presentorAddress', ''), min_fs=9)
        # Presentor contact — use separate fields (fallback to old combined presentorContact)
        pcontact = data.get('presentorContact', '')
        _set('fill_16_P.1', data.get('presentorPhone', '') or (pcontact.split('/')[0].strip() if pcontact else ''))
        _set('fill_17_P.1', data.get('presentorFax', ''))
        _set('fill_18_P.1', data.get('presentorEmail', ''))
        _set('fill_19_P.1', data.get('presentorReference', ''))
        # Fallback: if only old presentorContact was sent, try splitting
        if pcontact and not data.get('presentorPhone') and not data.get('presentorEmail'):
            parts_contact = [c.strip() for c in pcontact.replace('\n', '/').split('/')]
            if len(parts_contact) >= 4:
                _set('fill_16_P.1', parts_contact[0]); _set('fill_17_P.1', parts_contact[1])
                _set('fill_18_P.1', parts_contact[2]); _set('fill_19_P.1', parts_contact[3])
            elif len(parts_contact) >= 3:
                _set('fill_16_P.1', parts_contact[0]); _set('fill_17_P.1', parts_contact[1])
                _set('fill_18_P.1', parts_contact[2])
            elif len(parts_contact) == 2:
                _set('fill_16_P.1', parts_contact[0]); _set('fill_18_P.1', parts_contact[1])
            else:
                _set('fill_18_P.1', pcontact)
        # Sign date (fill_11/12/13 are cessation date D/M/Y at y=612)
        if data.get('signDate'):
            sd = data['signDate']
            if '-' in sd:
                parts = sd.split('-')
                if len(parts) >= 3:
                    _set('fill_11_P.1', parts[2])  # day
                    _set('fill_12_P.1', parts[1])  # month
                    _set('fill_13_P.1', parts[0])  # year
            elif '/' in sd:
                parts = sd.split('/')
                if len(parts) >= 3:
                    _set('fill_11_P.1', parts[0])  # day
                    _set('fill_12_P.1', parts[1])  # month
                    _set('fill_13_P.1', parts[2])  # year

    # Stamp BR on every page before blank-page removal
    _stamp_br_on_all_pages(doc, br8)

    # Apply CJK text overlays
    _apply_cjk_overlays()

    # Collect unmatched fields for warnings (like generate_template_pdf)
    _unmatched = [name for name in _all_attempted_fields if name not in fmap]
    _unmatched_cb = [name for name in _all_attempted_checkboxes if name not in fmap]

    # Remove blank pages (pages with no filled widgets, except P.1).
    # Also count pages that have CJK overlays — these pages are NOT blank.
    filled_pages = {0}
    # Pages with CJK text overlays
    for pi, _, _, _, _ in _cjk_overlays:
        filled_pages.add(pi)
    # Pages with ASCII widget values
    for pi in range(doc.page_count):
        if pi == 0:
            continue
        for w in doc[pi].widgets():
            try:
                if w.field_value:
                    filled_pages.add(pi)
                    break
            except Exception:
                pass

    blank = [pi for pi in reversed(range(doc.page_count)) if pi not in filled_pages]
    for pi in blank:
        doc.delete_page(pi)

    pdf_bytes = doc.write(deflate=True)
    doc.close()
    if _unmatched or _unmatched_cb:
        print(f"[ND2A] WARNING — unmatched fields: {_unmatched}, checkboxes: {_unmatched_cb}")
    return pdf_bytes, (_unmatched, _unmatched_cb)


@app.route('/api/generate-nd2a-pdf', methods=['POST'])
def generate_nd2a_pdf():
    try:
        data = request.json
        if not data:
            return jsonify({'error': 'Empty request body'}), 400
        pdf_bytes, (unmatched, unmatched_cb) = _fill_nd2a_pdf(data)
        import base64 as b64
        resp = {'pdf': b64.b64encode(pdf_bytes).decode('ascii')}
        if unmatched or unmatched_cb:
            resp['warnings'] = {'unmatchedFields': unmatched, 'unmatchedCheckboxes': unmatched_cb}
        return jsonify(resp)
    except Exception as e:
        import traceback
        traceback.print_exc()
        return jsonify({'error': str(e)}), 500


# ─── NN6 PDF 生成（非香港公司更改秘書及董事） ───

@app.route('/api/generate-nn6-pdf', methods=['POST'])
def generate_nn6_pdf():
    try:
        data = request.json
        if not data:
            return jsonify({'error': 'Empty request body'}), 400
        pdf_bytes, (unmatched, unmatched_cb) = _fill_nd2a_pdf(data, template='NN6-template.pdf')
        import base64 as b64
        resp = {'pdf': b64.b64encode(pdf_bytes).decode('ascii')}
        if unmatched or unmatched_cb:
            resp['warnings'] = {'unmatchedFields': unmatched, 'unmatchedCheckboxes': unmatched_cb}
        return jsonify(resp)
    except Exception as e:
        import traceback
        traceback.print_exc()
        return jsonify({'error': str(e)}), 500


# ─── ND2B PDF 生成（更改董事秘書詳情） ───

def _fill_nd2b_pdf(data, template='ND2B-template.pdf'):
    """Fill ND2B/NN7 PDF template using PyMuPDF"""
    template_path = os.path.join(os.path.dirname(__file__), '..', 'public', 'templates', template)
    doc = fitz.open(template_path)
    is_nn7 = 'NN7' in template
    fmap = {}
    for pi in range(doc.page_count):
        for w in doc[pi].widgets():
            if w.field_name:
                fmap[w.field_name] = pi

    # ── Fill helpers ──
    # For all fields: w.field_value + w.update() (generates valid AP)
    # For CJK fields: additionally overlay with system CJK font + hide widget (F=3)
    #   because w.update() hardcodes Helv which can't render CJK glyphs
    _cjk_overlays = []  # (page_idx, rect, value, fontsize, annot_xref)
    _all_attempted_fields = []     # track for warnings
    _all_attempted_checkboxes = []  # track for warnings
    _cjk_ap_font_pages = set()     # track CJK font embedding per page (widget AP)
    _cjk_ap_font_xref_map = {}     # page_idx → font PDF xref (widget AP)

    # Resolve system CJK font once
    _sys_fonts = [
        'C:/Windows/Fonts/simhei.ttf',   # ~10MB, good CJK coverage
        'C:/Windows/Fonts/simsun.ttc',   # fallback
        'C:/Windows/Fonts/msjh.ttc',     # fallback (~21MB)
        'C:/Windows/Fonts/Deng.ttf',     # last resort
    ]
    _cjk_fontfile = None
    for _sf in _sys_fonts:
        if os.path.exists(_sf):
            _cjk_fontfile = _sf
            break

    def _set(name, value, min_fs=6, use_ap=False, align='left', valign='bottom'):
        _all_attempted_fields.append(name)
        if name not in fmap or not value:
            return
        vstr = str(value)
        pi = fmap[name]
        for w in doc[pi].widgets():
            if w.field_name == name:
                has_cjk = any(ord(c) > 127 for c in vstr)
                fs = w.text_fontsize if w.text_fontsize and w.text_fontsize > 0 else 10
                field_w = w.rect.width
                field_h = w.rect.height
                usable_w = field_w - 3.0
                cjk_n = sum(1 for c in vstr if ord(c) > 127)
                asc_n = len(vstr) - cjk_n
                est_w = fs * (cjk_n * 1.0 + asc_n * 0.52)
                if usable_w > 0 and est_w > usable_w:
                    fs = max(min_fs, int(fs * usable_w / est_w * 0.95))
                if field_h > 0:
                    fs = min(fs, max(min_fs, int(field_h - 2)))
                if align == 'center' and _cjk_fontfile and has_cjk:
                    _set_widget_cjk_ap(doc, doc[pi], w, vstr, fs, _cjk_fontfile,
                                       _cjk_ap_font_pages, _cjk_ap_font_xref_map, align='center', valign=valign)
                elif use_ap and _cjk_fontfile and has_cjk:
                    _set_widget_cjk_ap(doc, doc[pi], w, vstr, fs, _cjk_fontfile,
                                       _cjk_ap_font_pages, _cjk_ap_font_xref_map, align='left', valign=valign)
                else:
                    try:
                        w.field_value = vstr
                        w.text_fontsize = fs
                        w.update()
                    except Exception:
                        pass
                    if has_cjk and _cjk_fontfile:
                        _cjk_overlays.append((pi, w.rect, vstr, fs, w._annot.xref))
                break

    def _check(name):
        _all_attempted_checkboxes.append(name)
        if name not in fmap:
            return
        pi = fmap[name]
        for w in doc[pi].widgets():
            if w.field_name == name:
                try:
                    w.field_value = True
                    w.update()
                except Exception:
                    pass
                break

    _cjk_fontname = None  # will be set once when font is first embedded

    def _apply_cjk_overlays():
        """Overlay CJK text on each page using system CJK font, then hide the
        original Helv-rendered widgets (F=3).

        IMPORTANT: PyMuPDF 1.28 insert_textbox(fontfile=...) does NOT embed the
        font in the PDF (bug), making CJK characters invisible. Workaround:
        page.insert_font() to pre-embed, then insert_textbox(fontname=...)."""
        nonlocal _cjk_fontname
        if not _cjk_overlays or not _cjk_fontfile:
            return
        _cjk_fontname = 'CJK'
        _font_pages = set()
        for pi, rect, value, fontsize, annot_xref in _cjk_overlays:
            try:
                doc[pi].clean_contents()
            except Exception:
                pass
            try:
                # Embed CJK font on this page (once per page)
                if pi not in _font_pages:
                    doc[pi].insert_font(fontname=_cjk_fontname, fontfile=_cjk_fontfile)
                    _font_pages.add(pi)
                inset = 1.5
                text_rect = fitz.Rect(
                    rect.x0 + inset, rect.y0 + inset,
                    rect.x1 - inset, rect.y1 - inset
                )
                doc[pi].insert_textbox(
                    text_rect,
                    value,
                    fontname=_cjk_fontname,
                    fontsize=fontsize,
                    color=(0, 0, 0),
                )
                doc.xref_set_key(annot_xref, 'F', '3')
            except Exception:
                pass

    br8 = re.sub(r'[^0-9A-Za-z]', '', data.get('brNumber', '') or '')[:8]
    # 優先使用前端拆分的 surname/otherNames，否則從 nameEnglish 解析
    sn = data.get('nameSurname', '')
    on = data.get('nameOtherNames', '')
    ne = data.get('nameEnglish', '')
    print(f'[ND2B DEBUG] RAW INPUT: sn={repr(sn)}, on={repr(on)}, ne={repr(ne)}')
    if sn and on:
        surname, other = sn, on
        print(f'[ND2B DEBUG] Branch 1 (both): surname={repr(surname)}, other={repr(other)}')
    elif sn and not on:
        surname, other = _parse_english_name(sn)
        print(f'[ND2B DEBUG] Branch 2 (sn only): parsed → surname={repr(surname)}, other={repr(other)}')
    elif on and not sn:
        # Only otherNames provided — parse first word as surname
        # (fixes: both names end up in fill_5 when surname is empty)
        surname, other = _parse_english_name(on)
        print(f'[ND2B DEBUG] Branch 3 (on only): parsed → surname={repr(surname)}, other={repr(other)}')
    else:
        # Neither provided — fall back to combined nameEnglish
        surname, other = _parse_english_name(ne)
        print(f'[ND2B DEBUG] Branch 4 (fallback ne): parsed → surname={repr(surname)}, other={repr(other)}')

    # P.1: Company info
    _set('fill_1_P.1', br8)
    _set('fill_2_P.1', data.get('companyName', ''))

    # Set BR on every page that has a BR widget (P.2-P.6 etc.)
    for pi in range(2, doc.page_count + 1):
        br_field = f'fill_1_P.{pi}'
        if br_field in fmap:
            _set(br_field, br8)

    is_natural = data.get('identity') == 'natural'
    role = data.get('role', '')
    # Backward compat: old changeType string → new changeTypes array
    change_types = data.get('changeTypes', [])
    if not change_types:
        old_type = data.get('changeType', 'address')
        change_types = [old_type] if old_type else ['address']

    # ── P.1: Person identity checkbox ──
    if is_natural:
        if role == 'secretary':
            _check('cb_1_P.1')
        else:
            _check('cb_2_P.1')
    else:
        _check('cb_3_P.1')   # body corporate checkbox

    # ── P.1: Person name fields (natural & corporate share same fill_3~fill_7) ──
    if is_natural:
        # Natural person: surname + other names split
        _set_cn = data.get('nameChinese', '')
        _set_surname = surname
        _set_other = other
        _set_id = data.get('idNumber', '')
        _set_passport = data.get('passportNumber', '')
    else:
        # Body corporate: use parsed surname/other if available, else full English name
        _set_cn = data.get('nameChinese', '')
        if surname and other:
            _set_surname = surname
            _set_other = other
        else:
            _set_surname = ''
            _set_other = data.get('nameEnglish', '')  # full corporate English name
        _set_id = data.get('companyNumber', data.get('idNumber', ''))
        _set_passport = data.get('passportNumber', '')

    print(f'[ND2B DEBUG] P.1 fill values: _set_cn={repr(_set_cn)}, _set_surname={repr(_set_surname)}, _set_other={repr(_set_other)}, is_nn7={is_nn7}')
    if is_nn7:
        _set('fill_3_P.1', _set_cn, align='center')
        _set('fill_4_P.1', _set_surname)
        _set('fill_5_P.1', _set_other)
        _set('fill_6_P.1', _set_id)      # HKID / Company No (narrow)
        _set('fill_7_P.1', _set_passport)  # Passport (wider)
    else:
        _set('fill_3_P.1', _set_cn, align='center')
        _set('fill_4_P.1', _set_surname)   # 英文姓氏
        _set('fill_5_P.1', _set_other)     # 英文名字
        _set('fill_6_P.1', _set_id)       # HKID / Company No (narrow, 73px)
        _set('fill_7_P.1', _set_passport)  # Passport (wider, 193px)

    # ── P.2: Change details (continuation sheet) ──
    # Parse effective date into (D, M, Y) tuple
    _ed_d = _ed_m = _ed_y = ''
    if data.get('effectiveDate'):
        ed = data['effectiveDate']
        if '-' in ed:
            parts = ed.split('-')
            if len(parts) >= 3:
                _ed_d, _ed_m, _ed_y = parts[2], parts[1], parts[0]
        elif '/' in ed:
            parts = ed.split('/')
            if len(parts) >= 3:
                _ed_d, _ed_m, _ed_y = parts[0], parts[1], parts[2]

    # Build new English full name (surname + otherNames), fallback to old newNameEnglish
    _new_en = ' '.join(filter(None, [
        data.get('newNameSurname', ''),
        data.get('newNameOtherNames', '')
    ])) or data.get('newNameEnglish', '')

    # Parse new name surname/otherNames robustly (same logic as main name)
    _new_sn = data.get('newNameSurname', '')
    _new_on = data.get('newNameOtherNames', '')
    if not _new_sn and _new_on:
        _new_sn, _new_on = _parse_english_name(_new_on)
    elif not _new_sn and not _new_on and _new_en:
        _new_sn, _new_on = _parse_english_name(_new_en)

    # ── Address helper ──
    def _get_addr_field(key):
        return data.get(f'new{key}') or data.get(f'addr{key}') or ''

    addr_flat = ', '.join(filter(None, [_get_addr_field('Flat'), _get_addr_field('Block')]))
    addr_building = _get_addr_field('Building')
    addr_street = _get_addr_field('Street')
    addr_district = _get_addr_field('District')
    addr_region = _get_addr_field('Region')
    has_addr = any([addr_flat, addr_building, addr_street, addr_district, addr_region])

    if is_nn7:
        # ═══ NN7 P.2 (separate template layout) ═══
        _set('fill_2_P.2', _set_cn, align='center')
        _set('fill_6_P.2', _set_surname, align='center')
        _set('fill_7_P.2', _set_other, align='center')
        if _ed_d:
            _set('fill_8_P.2', _ed_d)
            _set('fill_9_P.2', _ed_m)
            _set('fill_10_P.2', _ed_y)
        if 'name' in change_types:
            _set('fill_11_P.2', data.get('newNameChinese', data.get('nameChinese', '')))
            _set('fill_12_P.2', _new_en)
        # NN7 address
        if has_addr:
            _set('fill_19_P.2', addr_flat, use_ap=True)
            _set('fill_20_P.2', addr_building, use_ap=True)
            _set('fill_21_P.2', addr_street, use_ap=True)
            _set('fill_22_P.2', addr_district, use_ap=True)
            _set('fill_23_P.2', addr_region or '香港', use_ap=True)
            if _ed_d:
                _set('fill_24_P.2', _ed_d)
                _set('fill_25_P.2', _ed_m)
                _set('fill_26_P.2', _ed_y)
        # NN7 extra fields
        _set('fill_27_P.2', data.get('newEmail', '') or data.get('email', ''))
        _set('fill_31_P.2', data.get('newPhone', '') or data.get('phone', ''))
        _set('fill_35_P.2', data.get('passportPlaceOfIssue', ''))
        _set('fill_36_P.2', data.get('passportNumber', ''))
    else:
        # ═══ ND2B P.2 — 只填已勾選的變更項目 ═══
        # Officer identification (always shown)
        _set('fill_2_P.2', _set_cn, align='center')   # (a) 中文姓名
        _set('fill_6_P.2', _set_surname)               # (b) 英文姓氏
        _set('fill_7_P.2', _set_other)                 # (b) 英文名字

        if _ed_d:
            # ── 姓名更改 (a)(b)(c) ──
            if 'name' in change_types:
                _set('fill_2_P.2', data.get('newNameChinese', _set_cn), align='center')
                _set('fill_3_P.2', _ed_d)              # (a) date D
                _set('fill_4_P.2', _ed_m)              # (a) date M
                _set('fill_5_P.2', _ed_y)              # (a) date Y
                _set('fill_6_P.2', _new_sn or _set_surname)
                _set('fill_7_P.2', _new_on or _set_other)
                _set('fill_8_P.2', _ed_d)              # (b) date D
                _set('fill_9_P.2', _ed_m)              # (b) date M
                _set('fill_10_P.2', _ed_y)             # (b) date Y
                # (c) Alias 別名
                _alias_cn = data.get('newAliasChinese', '')
                _alias_en = data.get('newAliasEnglish', '')
                if _alias_cn or _alias_en:
                    _set('fill_11_P.2', _alias_cn, align='center')  # (c) 中文別名（居中藍框）
                    _set('fill_12_P.2', _alias_en)      # (c) 英文別名
                    _set('fill_13_P.2', _ed_d)          # (c) date D
                    _set('fill_14_P.2', _ed_m)          # (c) date M
                    _set('fill_15_P.2', _ed_y)          # (c) date Y

            # ── 地址更改 (d)(e) ──
            if 'address' in change_types and has_addr:
                _set('fill_16_P.2', _ed_d)             # (d) date D
                _set('fill_17_P.2', _ed_m)             # (d) date M
                _set('fill_18_P.2', _ed_y)             # (d) date Y
                _set('fill_19_P.2', addr_flat, use_ap=True)      # (e) 室/樓/座
                _set('fill_20_P.2', addr_building, use_ap=True)  # (e) 大廈
                _set('fill_21_P.2', addr_street, use_ap=True)    # (e) 街道
                _set('fill_22_P.2', addr_district, use_ap=True)  # (e) 區
                _set('fill_23_P.2', addr_region or '香港', use_ap=True)  # (e) 地區
                _set('fill_24_P.2', _ed_d)             # (e) date D
                _set('fill_25_P.2', _ed_m)             # (e) date M
                _set('fill_26_P.2', _ed_y)             # (e) date Y

            # ── 聯絡資料更改 (f) ──
            if 'contact' in change_types:
                _new_email = data.get('newEmail', '')
                if _new_email:
                    _set('fill_27_P.2', _new_email)     # (f) 電郵
                    _set('fill_28_P.2', _ed_d)          # (f) date D
                    _set('fill_29_P.2', _ed_m)          # (f) date M
                    _set('fill_30_P.2', _ed_y)          # (f) date Y

            # ── 證件更改 (g)(h) ──
            if 'id' in change_types:
                _new_id = data.get('newIdNumber', '')
                if _new_id:
                    _set('fill_31_P.2', _new_id)        # (g) 新身份證
                    _set('fill_32_P.2', _ed_d)          # (g) date D
                    _set('fill_33_P.2', _ed_m)          # (g) date M
                    _set('fill_34_P.2', _ed_y)          # (g) date Y
                _new_passport = data.get('passportNumber', '')
                if _new_passport:
                    _set('fill_35_P.2', data.get('passportPlaceOfIssue', ''))  # (h) 簽發國
                    _set('fill_36_P.2', _new_passport)   # (h) 護照號碼
                    _set('fill_37_P.2', _ed_d)           # (h) date D
                    _set('fill_38_P.2', _ed_m)           # (h) date M
                    _set('fill_39_P.2', _ed_y)           # (h) date Y

    # ── P.6: Protected Information ──
    if role == 'secretary':
        _check('cb_1_P.6')
    else:
        _check('cb_2_P.6')
    _set('fill_2_P.6', _set_cn)
    _set('fill_3_P.6', _set_surname)
    _set('fill_4_P.6', _set_other)
    if has_addr:
        if is_nn7:
            _set('fill_9_P.6', addr_flat)
            _set('fill_10_P.6', addr_building)
            _set('fill_11_P.6', addr_street)
            _set('fill_12_P.6', addr_district)
            _set('fill_13_P.6', addr_region or '香港')
        else:
            # ND2B P.6: 全部藍框
            _set('fill_9_P.6', addr_flat, use_ap=True)
            _set('fill_10_P.6', addr_building, use_ap=True)
            _set('fill_11_P.6', addr_street, use_ap=True)
            _set('fill_12_P.6', addr_district, use_ap=True)
            _set('fill_13_P.6', addr_region or '香港', use_ap=True)
    else:
        raw = data.get('newAddress') or data.get('previousAddress', '')
        if raw:
            parsed6 = _parse_address(raw)
            if is_nn7:
                _set('fill_9_P.6', parsed6.get('flat', ''))
                _set('fill_10_P.6', ', '.join(filter(None, [parsed6.get('block', ''), parsed6.get('building', '')])))
                _set('fill_11_P.6', parsed6.get('street', ''))
                _set('fill_12_P.6', parsed6.get('district', ''))
                _set('fill_13_P.6', parsed6.get('country', '') or '香港')
            else:
                # ND2B P.6 fallback: 室樓座/大廈/街道/區/地區
                _set('fill_9_P.6', parsed6.get('flat', ''), use_ap=True)
                _set('fill_10_P.6', ', '.join(filter(None, [parsed6.get('block', ''), parsed6.get('building', '')])))
                _set('fill_11_P.6', parsed6.get('street', ''))
                _set('fill_12_P.6', parsed6.get('district', ''))
                _set('fill_13_P.6', parsed6.get('country', '') or '香港')

    # Presentor (P.1 bottom)
    # fill_8 = Presentor Name  |  fill_9 = Address (tall)  |  fill_10 = Tel
    # fill_11 = Fax  |  fill_12 = Email  |  fill_13 = Reference
    _set('fill_8_P.1', data.get('presentorName', ''))
    _set('fill_9_P.1', data.get('presentorAddress', ''), min_fs=9)
    _set('fill_10_P.1', data.get('presentorPhone', data.get('presentorContact', '')))
    _set('fill_11_P.1', data.get('presentorFax', ''))
    _set('fill_12_P.1', data.get('presentorEmail', ''))
    _set('fill_13_P.1', data.get('presentorReference', ''))

    # P.3: Signature
    if is_nn7:
        # NN7 P.3: fill_25=簽署人姓名(藍框居中), fill_26=日期(DD/MM/YYYY single field)
        _set('fill_25_P.3', data.get('signerName', ''), align='center', valign='center')
        if data.get('signDate'):
            sd = data['signDate']
            if '-' in sd:
                parts = sd.split('-')
                if len(parts) >= 3:
                    _set('fill_26_P.3', f'{parts[2]}/{parts[1]}/{parts[0]}')
            elif '/' in sd:
                _set('fill_26_P.3', sd)
    else:
        # ND2B P.3: fill_30=signer, fill_27/28/29=D/M/Y, fill_31=full date
        _set('fill_30_P.3', data.get('signerName', ''))
        if data.get('signDate'):
            sd = data['signDate']
            d_val = m_val = y_val = ''
            if '-' in sd:
                parts = sd.split('-')
                if len(parts) >= 3:
                    y_val, m_val, d_val = parts[0], parts[1], parts[2]
            elif '/' in sd:
                parts = sd.split('/')
                if len(parts) >= 3:
                    d_val, m_val, y_val = parts[0], parts[1], parts[2]
            _set('fill_27_P.3', d_val)   # day
            _set('fill_28_P.3', m_val)   # month
            _set('fill_29_P.3', y_val)   # year
            _set('fill_31_P.3', f'{d_val}/{m_val}/{y_val}')

    # Stamp BR on every page before blank-page removal
    _stamp_br_on_all_pages(doc, br8)

    # Apply CJK text overlays
    _apply_cjk_overlays()

    # Collect unmatched fields for warnings (like generate_template_pdf)
    _unmatched = [name for name in _all_attempted_fields if name not in fmap]
    _unmatched_cb = [name for name in _all_attempted_checkboxes if name not in fmap]

    # Remove blank pages (pages with no filled widgets, except P.1).
    # Also count pages that have CJK overlays — these pages are NOT blank.
    filled_pages = {0}
    # Pages with CJK text overlays
    for pi, _, _, _, _ in _cjk_overlays:
        filled_pages.add(pi)
    # Pages with ASCII widget values
    for pi in range(doc.page_count):
        if pi == 0:
            continue
        for w in doc[pi].widgets():
            try:
                if w.field_value:
                    filled_pages.add(pi)
                    break
            except Exception:
                pass

    blank = [pi for pi in reversed(range(doc.page_count)) if pi not in filled_pages]
    for pi in blank:
        doc.delete_page(pi)

    pdf_bytes = doc.write(deflate=True)
    doc.close()
    if _unmatched or _unmatched_cb:
        print(f"[ND2B] WARNING — unmatched fields: {_unmatched}, checkboxes: {_unmatched_cb}")
    return pdf_bytes, (_unmatched, _unmatched_cb)


@app.route('/api/generate-nd2b-pdf', methods=['POST'])
def generate_nd2b_pdf():
    try:
        data = request.json
        if not data:
            return jsonify({'error': 'Empty request body'}), 400
        result = _fill_nd2b_pdf(data)
        pdf_bytes, warnings_tuple = result if isinstance(result, tuple) else (result, (None, None))
        unmatched_fields, unmatched_checkboxes = warnings_tuple
        import base64 as b64
        resp = {
            'pdf': b64.b64encode(pdf_bytes).decode('ascii'),
            '_debug': {
                'input_nameSurname': data.get('nameSurname', ''),
                'input_nameOtherNames': data.get('nameOtherNames', ''),
                'input_nameEnglish': data.get('nameEnglish', ''),
            }
        }
        if unmatched_fields or unmatched_checkboxes:
            resp['warnings'] = {
                'unmatched_fields': unmatched_fields,
                'unmatched_checkboxes': unmatched_checkboxes,
            }
        return jsonify(resp)
    except Exception as e:
        import traceback
        traceback.print_exc()
        return jsonify({'error': str(e)}), 500


# ─── NN7 PDF 生成（非香港公司更改秘書及董事詳情） ───

@app.route('/api/generate-nn7-pdf', methods=['POST'])
def generate_nn7_pdf():
    try:
        data = request.json
        if not data:
            return jsonify({'error': 'Empty request body'}), 400
        result = _fill_nd2b_pdf(data, template='NN7-template.pdf')
        pdf_bytes, warnings_tuple = result if isinstance(result, tuple) else (result, (None, None))
        unmatched_fields, unmatched_checkboxes = warnings_tuple
        import base64 as b64
        resp = {'pdf': b64.b64encode(pdf_bytes).decode('ascii')}
        if unmatched_fields or unmatched_checkboxes:
            resp['warnings'] = {
                'unmatched_fields': unmatched_fields,
                'unmatched_checkboxes': unmatched_checkboxes,
            }
        return jsonify(resp)
    except Exception as e:
        import traceback
        traceback.print_exc()
        return jsonify({'error': str(e)}), 500


# ─── Generic Form PDF 生成（Resolution / Rename / NewCompany） ───

@app.route('/api/generate-generic-form-pdf', methods=['POST'])
def generate_generic_form_pdf():
    try:
        data = request.json
        if not data:
            return jsonify({'error': 'Empty request body'}), 400

        pdf = FPDF()
        pdf.add_page()
        # Use system CJK font directly (font download in find_font() can hang)
        font_path = None
        for sys_font in ['C:/Windows/Fonts/msjh.ttc', 'C:/Windows/Fonts/Deng.ttf', 'C:/Windows/Fonts/simsun.ttc']:
            if os.path.exists(sys_font):
                font_path = sys_font
                break
        if font_path:
            pdf.add_font('TC', '', font_path)
            pdf.add_font('TC', 'B', font_path)
            font_name = 'TC'
        else:
            font_name = 'Helvetica'

        def safe_text(text):
            return (text or '').encode('utf-8', errors='replace').decode('utf-8')

        # Title
        pdf.set_font(font_name, 'B', 16)
        pdf.cell(0, 10, safe_text(data.get('title', '')), new_x=XPos.LMARGIN, new_y=YPos.NEXT, align='C')
        if data.get('subtitle'):
            pdf.set_font(font_name, '', 10)
            pdf.cell(0, 7, safe_text(data['subtitle']), new_x=XPos.LMARGIN, new_y=YPos.NEXT, align='C')
        pdf.ln(4)

        # Form code + company info
        pdf.set_font(font_name, '', 10)
        if data.get('formCode'):
            pdf.cell(30, 6, 'Form Code:', 0, 0)
            pdf.cell(0, 6, safe_text(data['formCode']), new_x=XPos.LMARGIN, new_y=YPos.NEXT)
        if data.get('companyName'):
            pdf.cell(30, 6, 'Company:', 0, 0)
            pdf.cell(0, 6, safe_text(data['companyName']), new_x=XPos.LMARGIN, new_y=YPos.NEXT)
        if data.get('brNumber'):
            pdf.cell(30, 6, 'BR No.:', 0, 0)
            pdf.cell(0, 6, safe_text(data['brNumber']), new_x=XPos.LMARGIN, new_y=YPos.NEXT)
        pdf.ln(4)

        # Sections
        sections = data.get('sections') or []
        for sec in sections:
            if sec.get('heading'):
                pdf.set_font(font_name, 'B', 11)
                pdf.cell(0, 7, safe_text(sec['heading']), new_x=XPos.LMARGIN, new_y=YPos.NEXT)
                pdf.ln(1)

            if sec.get('rows'):
                pdf.set_font(font_name, '', 9)
                for row in sec['rows']:
                    label = safe_text(row[0]) if len(row) > 0 else ''
                    value = safe_text(row[1]) if len(row) > 1 else ''
                    pdf.cell(50, 5, label + ':', 0, 0)
                    pdf.cell(0, 5, value, new_x=XPos.LMARGIN, new_y=YPos.NEXT)
                pdf.ln(2)

            if sec.get('paragraph'):
                pdf.set_font(font_name, '', 9)
                pdf.multi_cell(0, 5, safe_text(sec['paragraph']))
                pdf.ln(2)

            if sec.get('bullets'):
                pdf.set_font(font_name, '', 9)
                for b in sec['bullets']:
                    pdf.cell(5, 5, '', 0, 0)
                    pdf.cell(0, 5, chr(8226) + ' ' + safe_text(b), new_x=XPos.LMARGIN, new_y=YPos.NEXT)
                pdf.ln(2)

        # Signature lines
        sig_lines = data.get('signatureLines') or []
        if sig_lines:
            pdf.ln(6)
            pdf.set_font(font_name, '', 10)
            for sl in sig_lines:
                pdf.cell(0, 8, safe_text(sl), new_x=XPos.LMARGIN, new_y=YPos.NEXT)
                pdf.ln(2)

        pdf_bytes = bytes(pdf.output())
        import base64 as b64
        return jsonify({'pdf': b64.b64encode(pdf_bytes).decode('ascii')})
    except Exception as e:
        import traceback
        traceback.print_exc()
        return jsonify({'error': str(e)}), 500


# ─── Auto-Fill CR Form PDF（自動填入公司資料的政府表格 PDF） ───

@app.route('/api/generate-cr-form-pdf', methods=['POST', 'OPTIONS'])
def generate_cr_form_pdf():
    """Auto-fill a CR form PDF from company database data.
    Request: {company_id, form_code (nar1|nd2a|...|nn9)}"""
    if request.method == 'OPTIONS':
        return ('', 204)
    try:
        u = get_user()
        if not u:
            return jsonify({'error': 'Not authenticated'}), 401

        data = request.get_json(force=True, silent=True) or {}
        company_id = data.get('company_id')
        form_code = (data.get('form_code') or '').lower()
        if not company_id or not form_code:
            return jsonify({'error': '缺少 company_id 或 form_code'}), 400

        meta = CR_FORM_META.get(form_code)
        if not meta:
            return jsonify({'error': f'不支援的表格代碼：{form_code}'}), 400

        db = get_db()
        bundle = _docx_company_bundle(db, company_id)
        if not bundle:
            return jsonify({'error': '找不到該公司'}), 404
        c = bundle['c']
        name_en = c.get('name') or ''
        name_cn = c.get('chinese_name') or ''
        br = c.get('company_number') or ''
        cr_num = c.get('ci_number') or ''

        # Build PDF with fpdf2
        pdf = FPDF()
        pdf.add_page()
        font_path = None
        for sys_font in ['C:/Windows/Fonts/msjh.ttc', 'C:/Windows/Fonts/Deng.ttf', 'C:/Windows/Fonts/simsun.ttc']:
            if os.path.exists(sys_font):
                font_path = sys_font
                break
        if font_path:
            pdf.add_font('TC', '', font_path)
            pdf.add_font('TC', 'B', font_path)
            ft = 'TC'
        else:
            ft = 'Helvetica'

        def _t(text):
            return (text or '').encode('utf-8', errors='replace').decode('utf-8')

        def _person_label(m):
            en = (m.get('name_english') or '').strip()
            cn = (m.get('name_chinese') or '').strip()
            if en and cn:
                return f"{en}（{cn}）"
            return en or cn or '—'

        # Header
        pdf.set_font(ft, 'B', 16)
        pdf.cell(0, 10, _t(meta['title']), new_x=XPos.LMARGIN, new_y=YPos.NEXT, align='C')
        pdf.set_font(ft, '', 10)
        pdf.cell(0, 7, _t(f"{meta['code']} — {meta['title_en']}"), new_x=XPos.LMARGIN, new_y=YPos.NEXT, align='C')
        pdf.cell(0, 7, _t(f"公司註冊處表格 · 由系統自動填入 {name_en or name_cn} 的資料生成草稿"),
                 new_x=XPos.LMARGIN, new_y=YPos.NEXT, align='C')
        pdf.ln(4)

        # Company info section
        pdf.set_font(ft, 'B', 12)
        pdf.cell(0, 7, _t('公司基本資料'), new_x=XPos.LMARGIN, new_y=YPos.NEXT)
        pdf.set_font(ft, '', 9)
        info_rows = [
            ('英文名稱', name_en), ('中文名稱', name_cn),
            ('商業登記號碼 (BR)', br), ('公司註冊編號 (CR)', cr_num),
            ('公司類型', c.get('company_type')), ('成立日期', _docx_fmt_date(c.get('incorporation_date'))),
            ('狀態', c.get('status')), ('註冊辦事處地址', bundle['address']),
            ('電郵', c.get('email')), ('電話', c.get('phone')),
        ]
        for label, val in info_rows:
            if val:
                pdf.cell(50, 5, _t(label) + ':', 0, 0)
                pdf.cell(0, 5, _t(str(val)), new_x=XPos.LMARGIN, new_y=YPos.NEXT)
        pdf.ln(3)

        # Directors & Secretaries (most forms)
        has_officers = form_code in ('nar1','nd2a','nd2b','nd4','nnc1','nn1','nn3','nn6','nn7')
        if has_officers:
            pdf.set_font(ft, 'B', 11)
            pdf.cell(0, 7, _t(f"董事（{len(bundle['directors'])} 人）"), new_x=XPos.LMARGIN, new_y=YPos.NEXT)
            pdf.set_font(ft, '', 9)
            if bundle['directors']:
                for d in bundle['directors']:
                    pdf.cell(0, 5, _t(f"  {_person_label(d)}  |  {d.get('id_number') or d.get('passport_number') or ''}  |  委任: {_docx_fmt_date(d.get('date_appointed'))}  |  {d.get('address') or ''}"),
                             new_x=XPos.LMARGIN, new_y=YPos.NEXT)
            else:
                pdf.cell(0, 5, _t('  （無董事記錄）'), new_x=XPos.LMARGIN, new_y=YPos.NEXT)
            pdf.ln(2)

            pdf.set_font(ft, 'B', 11)
            pdf.cell(0, 7, _t(f"公司秘書（{len(bundle['secretaries'])} 人）"), new_x=XPos.LMARGIN, new_y=YPos.NEXT)
            pdf.set_font(ft, '', 9)
            if bundle['secretaries']:
                for s in bundle['secretaries']:
                    pdf.cell(0, 5, _t(f"  {_person_label(s)}  |  TCSP: {s.get('tcsp_number') or ''}  |  委任: {_docx_fmt_date(s.get('date_appointed'))}"),
                             new_x=XPos.LMARGIN, new_y=YPos.NEXT)
            else:
                pdf.cell(0, 5, _t('  （無秘書記錄）'), new_x=XPos.LMARGIN, new_y=YPos.NEXT)
            pdf.ln(3)

        # Shareholders
        has_shares = form_code in ('nar1','nsc1','nnc1','nn1','nn3')
        if has_shares:
            ts = bundle['total_shares']
            pdf.set_font(ft, 'B', 11)
            pdf.cell(0, 7, _t(f"股東／股本結構（總發行股數：{ts}）"), new_x=XPos.LMARGIN, new_y=YPos.NEXT)
            pdf.set_font(ft, '', 9)
            if bundle['shareholders']:
                for sh in bundle['shareholders']:
                    pct = f"{round(int(sh.get('shares') or 0) * 100 / ts, 2)}%" if ts else '—'
                    pdf.cell(0, 5, _t(f"  {_person_label(sh)}  |  {sh.get('shares')} 股  |  {sh.get('share_type') or '普通股'}  |  {pct}"),
                             new_x=XPos.LMARGIN, new_y=YPos.NEXT)
            else:
                pdf.cell(0, 5, _t('  （無股東記錄）'), new_x=XPos.LMARGIN, new_y=YPos.NEXT)
            pdf.ln(3)

        # Form-specific blocks
        if form_code == 'nar1':
            pdf.set_font(ft, '', 9)
            pdf.cell(0, 5, _t('重要控制人登記冊 (SCR) 是否備存於公司註冊辦事處？  是 □  否 □'), new_x=XPos.LMARGIN, new_y=YPos.NEXT)
            pdf.cell(0, 5, _t('截至申報日期之董事／秘書／股東資料以上表為準。'), new_x=XPos.LMARGIN, new_y=YPos.NEXT)
        if form_code in ('nr1', 'ndr1', 'nn9'):
            pdf.set_font(ft, '', 9)
            pdf.cell(0, 5, _t(f"現有註冊地址：{bundle['address'] or '（未填）'}"), new_x=XPos.LMARGIN, new_y=YPos.NEXT)
            pdf.cell(0, 5, _t('變更後註冊地址（請手動填寫）：＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿'), new_x=XPos.LMARGIN, new_y=YPos.NEXT)
        if form_code == 'nsc1':
            pdf.set_font(ft, '', 9)
            for line in ['配發日期：＿＿＿＿＿＿＿＿', '配發股份類別：＿＿＿＿＿＿＿＿', '每股發行價：＿＿＿＿＿＿＿＿', '配發總額：＿＿＿＿＿＿＿＿']:
                pdf.cell(0, 5, _t(line), new_x=XPos.LMARGIN, new_y=YPos.NEXT)
        if form_code in ('nnc1', 'nn1'):
            pdf.set_font(ft, '', 9)
            pdf.cell(0, 5, _t('擬成立公司之名稱／形式等詳情，請參考上方公司基本資料。'), new_x=XPos.LMARGIN, new_y=YPos.NEXT)
        if form_code in ('nnc2',):
            pdf.set_font(ft, '', 9)
            pdf.cell(0, 5, _t('更改後公司名稱（請手動填寫）：＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿'), new_x=XPos.LMARGIN, new_y=YPos.NEXT)

        # Signature block
        pdf.ln(6)
        pdf.set_font(ft, 'B', 11)
        pdf.cell(0, 7, _t('簽署 / SIGNED:'), new_x=XPos.LMARGIN, new_y=YPos.NEXT)
        pdf.ln(5)
        pdf.set_font(ft, '', 10)
        pdf.cell(0, 8, _t('_______________________________'), new_x=XPos.LMARGIN, new_y=YPos.NEXT)
        pdf.cell(0, 6, _t('董事 / Director       日期 Date：＿＿＿＿＿＿'), new_x=XPos.LMARGIN, new_y=YPos.NEXT)
        pdf.ln(3)
        pdf.cell(0, 8, _t('_______________________________'), new_x=XPos.LMARGIN, new_y=YPos.NEXT)
        pdf.cell(0, 6, _t('公司秘書 / Company Secretary       日期 Date：＿＿＿＿＿＿'), new_x=XPos.LMARGIN, new_y=YPos.NEXT)

        # Footer
        pdf.ln(6)
        pdf.set_font(ft, '', 7)
        pdf.cell(0, 5, _t(f"本文件由公司秘書管理系統自動生成 · {datetime.now().strftime('%Y-%m-%d %H:%M')}"),
                 new_x=XPos.LMARGIN, new_y=YPos.NEXT, align='C')

        pdf_bytes = bytes(pdf.output())
        safe_name = re.sub(r'[^\w一-鿿-]', '_', (name_en or name_cn or 'company'))[:30]
        filename = f"{meta['code']}_{meta['title']}_{safe_name}.pdf"
        return jsonify({
            'success': True,
            'pdf': base64.b64encode(pdf_bytes).decode('ascii'),
            'filename': filename,
        })
    except Exception as e:
        import traceback
        traceback.print_exc()
        return jsonify({'error': str(e)}), 500


# ─── Generic Template PDF Filler（PyMuPDF 填充任何 AcroForm 模板） ───

# Cache fitz.Font objects by fontfile path (loading 10MB CJK fonts is expensive)
_CJK_AP_FONT_CACHE = {}

def _get_cjk_font(fontfile):
    """Get or create a cached fitz.Font for glyph-index lookups."""
    if fontfile not in _CJK_AP_FONT_CACHE:
        _CJK_AP_FONT_CACHE[fontfile] = fitz.Font(fontfile=fontfile)
    return _CJK_AP_FONT_CACHE[fontfile]


def _set_widget_cjk_ap(doc, page, widget, text, fontsize, fontfile, font_pages, font_xref_map, align='left', valign='bottom'):
    """Build a custom widget AP stream with embedded CJK font.

    Unlike page-content overlay (which hides the widget with F=3),
    this writes the CJK text directly into the widget's /AP stream,
    so the widget stays visible as a blue editable box with readable CJK text.

    Automatically wraps text into multiple lines when it exceeds widget width
    at the given fontsize (instead of shrinking font below readability).

    align: 'left' (default) or 'center' — horizontal alignment per line.
    valign: 'bottom' (default) or 'center' — vertical alignment of the entire
            text block within the widget.
    """
    try:
        import re as _re
        pi = page.number
        fontname = 'CJK_TPL'

        # Embed CJK font on page if not already done (tracked per-page).
        # page.insert_font() returns the PDF xref of the inserted Font object
        # — use it directly instead of fragile Resources regex parsing.
        if pi not in font_pages:
            page.clean_contents()
            font_xref = page.insert_font(fontname=fontname, fontfile=fontfile)
            font_pages.add(pi)
            font_xref_map[pi] = font_xref
        font_xref = font_xref_map.get(pi)
        if not font_xref:
            return  # font embedding failed, skip this widget

        rect = widget.rect
        w_width = rect.width
        h_height = rect.height

        # Build AP content stream: render CJK text using the embedded font.
        #
        # CRITICAL: The PDF content stream's Tj operator expects glyph indices (CIDs)
        # for Type0 Identity-H CID fonts — NOT Unicode codepoints.
        # fitz.get_pdf_str() returns UTF-16BE hex (<FEFFXXXX…>), which is correct for
        # AcroForm /V values but WRONG for content streams. Using UTF-16BE codepoints
        # as CIDs causes every character to map to a completely different glyph → 乱码.
        #
        # Fix: convert each character to its glyph index via font.has_glyph(charcode).
        # Despite the boolean-sounding name, has_glyph() returns the glyph index (int)
        # if the glyph exists, or 0 for missing glyphs (which maps to .notdef).
        cjk_font = _get_cjk_font(fontfile)

        def _char_width(ch):
            """Width of a single character in points at current fontsize."""
            return fontsize * (1.0 if ord(ch) > 127 else 0.5)

        def _build_hex(line):
            """Convert a text line to PDF hex string using glyph indices."""
            gids = []
            for ch in line:
                gid = cjk_font.has_glyph(ord(ch))
                gids.append(gid if gid else 0)
            return '<' + ''.join(f'{gid:04x}' for gid in gids) + '>'

        inset = 2.0
        usable_w = w_width - 2 * inset
        line_height = fontsize * 1.35  # line spacing

        # ── Build lines: word-aware wrapping with explicit \n support ──
        # Split on explicit newlines first — each paragraph starts on its own line.
        # Then tokenize each paragraph: ASCII runs stay together; CJK chars are
        # individual tokens.  This keeps English words intact while allowing breaks
        # between any CJK char.
        paragraphs = text.split('\n')

        def _wrap_paragraph(para):
            """Tokenize and wrap a single paragraph. Empty → [''], else wrapped lines."""
            if not para:
                return ['']
            tokens = []
            i = 0
            while i < len(para):
                ch = para[i]
                if ord(ch) > 127:
                    tokens.append(ch)
                    i += 1
                else:
                    j = i
                    while j < len(para) and ord(para[j]) <= 127:
                        j += 1
                    tokens.append(para[i:j])
                    i = j

            para_width = sum(_char_width(ch) for ch in para)
            if para_width <= usable_w:
                return [para]

            lines = []
            cur_tokens = []
            cur_w = 0.0
            for tok in tokens:
                tok_w = sum(_char_width(ch) for ch in tok)
                if tok_w > usable_w:
                    if cur_tokens:
                        lines.append(''.join(cur_tokens))
                        cur_tokens = []
                        cur_w = 0.0
                    for ch in tok:
                        ch_w = _char_width(ch)
                        if cur_w + ch_w > usable_w and cur_tokens:
                            lines.append(''.join(cur_tokens))
                            cur_tokens = [ch]
                            cur_w = ch_w
                        else:
                            cur_tokens.append(ch)
                            cur_w += ch_w
                elif cur_w + tok_w > usable_w:
                    lines.append(''.join(cur_tokens))
                    cur_tokens = [tok]
                    cur_w = tok_w
                else:
                    cur_tokens.append(tok)
                    cur_w += tok_w
            if cur_tokens:
                lines.append(''.join(cur_tokens))
            return lines

        lines = []
        for para in paragraphs:
            lines.extend(_wrap_paragraph(para))

        # Limit lines to what fits vertically in the widget
        max_lines = max(1, int((h_height - inset) / line_height))
        if len(lines) > max_lines:
            lines = lines[:max_lines]
            # Truncate last visible line with ellipsis
            if len(lines[-1]) > 1:
                # Remove last 2 chars + add "…"
                lines[-1] = lines[-1][:-2] + '…'

        line_hexes = [_build_hex(ln) for ln in lines]

        # ── Calculate positions per line ──
        line_widths = [sum(_char_width(ch) for ch in ln) for ln in lines]
        total_block_h = len(lines) * line_height

        # Vertical start position for the entire text block
        if valign == 'center':
            # Center the block within the widget
            block_top = (h_height - total_block_h) / 2.0
        else:
            # Bottom-align: first line at top of widget, descending
            block_top = 0.0

        # Build content stream — one Tm + Tj per line
        stream_parts = [f"/Tx BMC\nq\nBT\n/{fontname} {fontsize} Tf"]
        for i, (lh, lw) in enumerate(zip(line_hexes, line_widths)):
            if align == 'center':
                lx = max(inset, (w_width - lw) / 2.0)
            else:
                lx = inset
            # PDF y-coord: baseline is fontsize*0.8 above the bottom of the line box.
            # line_top = block_top + i * line_height
            # baseline_y from bottom of widget = h_height - (block_top + i*line_height + fontsize*1.05)
            ly = h_height - (block_top + i * line_height + fontsize * 1.05)
            stream_parts.append(f"1 0 0 1 {lx} {ly} Tm\n{lh} Tj")
        stream_parts.append("ET\nQ\nEMC")
        stream = '\n'.join(stream_parts)
    except Exception:
        return  # If font embedding or text processing fails, skip this widget

    try:
        # Create a new PDF object for the Form XObject
        form_xref = doc.get_new_xref()
        form_dict = (
            f'<<\n'
            f'/Type /XObject\n'
            f'/Subtype /Form\n'
            f'/BBox [0 0 {w_width} {h_height}]\n'
            f'/Resources << /Font << /{fontname} {font_xref} 0 R >> >>\n'
            f'/Length {len(stream.encode("utf-8"))}\n'
            f'>>'
        )
        doc.update_object(form_xref, form_dict)
        doc.update_stream(form_xref, stream.encode('utf-8'))

        # Set as widget's normal appearance
        annot_xref = widget._annot.xref
        ap_dict = f'<< /N {form_xref} 0 R >>'
        doc.xref_set_key(annot_xref, 'AP', ap_dict)

        # Set the field value (UTF-16BE is correct for AcroForm /V)
        doc.xref_set_key(annot_xref, 'V', fitz.get_pdf_str(text))
    except Exception:
        pass  # If anything fails, widget stays unfilled (better than crashing)


@app.route('/api/generate-template-pdf', methods=['POST'])
def generate_template_pdf():
    """Fill any AcroForm PDF template with provided field values.
    Request: {template: 'ND4-template.pdf', fields: {'fill_1_P.1': 'val', ...},
              checkboxes: ['cb_1_P.1', ...], brNumber: '07281051',
              overlays: [{page, text, x, y, fontsize}],
              keepWidgets: true}  # Keep CJK widgets visible (blue editable boxes)"""
    try:
        data = request.json
        if not data:
            return jsonify({'error': 'Empty request body'}), 400

        template_name = data.get('template', '')
        if not template_name:
            return jsonify({'error': 'template name required'}), 400

        # Debug log for NN9 requests
        if 'NN9' in template_name:
            fields = data.get('fields') or {}
            sub_fields = {k: v for k, v in fields.items() if any(k.startswith(p) for p in ['fill_18', 'fill_19', 'fill_20', 'fill_21', 'fill_22', 'fill_23'])}
            print(f'[NN9] Received submitter fields: {sub_fields}')

        # Security: only allow .pdf files in templates dir
        safe_name = os.path.basename(template_name)
        if not safe_name.endswith('.pdf') or '..' in safe_name:
            return jsonify({'error': 'invalid template name'}), 400

        template_path = os.path.join(os.path.dirname(__file__), '..', 'public', 'templates', safe_name)
        if not os.path.exists(template_path):
            return jsonify({'error': f'Template not found: {safe_name}'}), 404

        doc = fitz.open(template_path)

        # Build field → page map
        fmap = {}
        for pi in range(doc.page_count):
            for w in doc[pi].widgets():
                if w.field_name:
                    fmap[w.field_name] = pi

        fields = data.get('fields') or {}
        checkboxes = data.get('checkboxes') or []
        br_number = data.get('brNumber', '')
        overlays = data.get('overlays') or []  # [{page, text, x, y, fontsize}]
        keep_widgets = data.get('keepWidgets', False)
        align_center_fields = set(data.get('alignCenterFields') or [])
        align_vcenter_fields = set(data.get('alignVCenterFields') or [])
        field_min_font_size = data.get('fieldMinFontSize') or {}  # {field_name: min_fontsize, ...}
        force_widget_ap = set(data.get('forceWidgetAp') or [])   # Always use _set_widget_cjk_ap (even ASCII)

        # Locate a system CJK font for overlays
        _tpl_cjk_fontfile = None
        for _sf in ['C:/Windows/Fonts/simhei.ttf', 'C:/Windows/Fonts/simsun.ttc',
                     'C:/Windows/Fonts/msjh.ttc', 'C:/Windows/Fonts/Deng.ttf']:
            if os.path.exists(_sf):
                _tpl_cjk_fontfile = _sf
                break

        # Track unmatched fields for warning
        unmatched_fields = []
        unmatched_checkboxes = []

        # Collect CJK-overlay info: (page_idx, rect, text, fontsize, annot_xref)
        _cjk_overlays = []

        # Track CJK font embedding per page (for widget AP approach)
        _cjk_ap_font_pages = set()
        _cjk_ap_font_xref_map = {}  # page_idx → font PDF xref

        # Fill text fields (with adaptive font sizing)
        for name, value in fields.items():
            if name not in fmap:
                unmatched_fields.append(name)
                continue
            pi = fmap[name]
            for w in doc[pi].widgets():
                if w.field_name == name:
                    try:
                        vstr = str(value) if value else ''
                        if not vstr:
                            break
                        # Adaptive font size based on field width + height
                        fs = w.text_fontsize if w.text_fontsize and w.text_fontsize > 0 else 10
                        field_w = w.rect.width
                        field_h = w.rect.height
                        cjk_n = sum(1 for c in vstr if ord(c) > 127)
                        asc_n = len(vstr) - cjk_n
                        usable_w = field_w - 4.0  # account for field padding
                        if usable_w > 0:
                            est_w = fs * (cjk_n * 1.0 + asc_n * 0.66)  # Helv: 0.66 covers uppercase names
                            if est_w > usable_w:
                                fs = max(6, int(fs * usable_w / est_w * 0.95))
                        # Cap font size to field height (leave ~3pt padding)
                        if field_h > 0:
                            fs = min(fs, max(6, int(field_h - 3)))
                        # Per-field minimum font size override
                        if name in field_min_font_size:
                            fs = max(fs, int(field_min_font_size[name]))
                        if (cjk_n > 0 or name in force_widget_ap) and _tpl_cjk_fontfile:
                            if keep_widgets:
                                # Build custom AP stream with embedded CJK font
                                # → blue editable box + readable CJK text
                                _align = 'center' if name in align_center_fields else 'left'
                                _valign = 'center' if name in align_vcenter_fields else 'bottom'
                                _set_widget_cjk_ap(
                                    doc, doc[pi], w, vstr, fs,
                                    _tpl_cjk_fontfile, _cjk_ap_font_pages,
                                    _cjk_ap_font_xref_map, align=_align, valign=_valign)
                            else:
                                # Legacy: overlay CJK on page content, hide widget
                                doc.xref_set_key(w._annot.xref, 'V', fitz.get_pdf_str(vstr))
                                _cjk_overlays.append((pi, w.rect, vstr, fs, w._annot.xref))
                        else:
                            w.field_value = vstr
                            w.text_fontsize = fs
                            w.update()
                    except Exception:
                        pass
                    break

        # Apply CJK overlays (once per page) — legacy mode only
        _cjk_font_pages = set()
        if _cjk_overlays and _tpl_cjk_fontfile:
            for pi, rect, value, fontsize, annot_xref in _cjk_overlays:
                try:
                    if pi not in _cjk_font_pages:
                        doc[pi].clean_contents()
                        doc[pi].insert_font(fontname='CJK_TPL', fontfile=_tpl_cjk_fontfile)
                        _cjk_font_pages.add(pi)
                    inset = 1.5
                    text_rect = fitz.Rect(
                        rect.x0 + inset, rect.y0 + inset,
                        rect.x1 - inset, rect.y1 - inset)
                    doc[pi].insert_textbox(
                        text_rect, value, fontname='CJK_TPL', fontsize=fontsize,
                        color=(0, 0, 0))
                    doc.xref_set_key(annot_xref, 'F', '3')
                except Exception:
                    pass

        # Merge font-page tracking: legacy overlays + new widget-AP mode
        _all_cjk_pages = _cjk_font_pages | _cjk_ap_font_pages

        # Apply explicit text overlays (e.g. date on P.3 where no form fields exist)
        for ov in overlays:
            try:
                pi = int(ov.get('page', 0))
                text = str(ov.get('text', ''))
                x = float(ov.get('x', 100))
                y = float(ov.get('y', 100))
                fs = float(ov.get('fontsize', 10))
                if not text or pi < 0 or pi >= doc.page_count:
                    continue
                if _tpl_cjk_fontfile:
                    if pi not in _all_cjk_pages:
                        doc[pi].clean_contents()
                        doc[pi].insert_font(fontname='CJK_TPL', fontfile=_tpl_cjk_fontfile)
                        _all_cjk_pages.add(pi)
                    cjk_n = sum(1 for c in text if ord(c) > 127)
                    tw = fs * (cjk_n * 1.0 + (len(text) - cjk_n) * 0.52)
                    text_rect = fitz.Rect(x, y, x + tw + 10, y + fs + 5)
                    doc[pi].insert_textbox(
                        text_rect, text, fontname='CJK_TPL', fontsize=fs,
                        color=(0, 0, 0))
                else:
                    # Fallback: insert plain text with built-in font
                    tw = fs * len(text) * 0.6
                    text_rect = fitz.Rect(x, y, x + tw + 10, y + fs + 5)
                    doc[pi].insert_textbox(
                        text_rect, text, fontname='Helv', fontsize=fs,
                        color=(0, 0, 0))
            except Exception:
                pass

        # Check checkboxes
        for name in checkboxes:
            if name not in fmap:
                unmatched_checkboxes.append(name)
                continue
            pi = fmap[name]
            for w in doc[pi].widgets():
                if w.field_name == name:
                    try:
                        w.field_value = True
                        w.update()
                    except Exception:
                        pass
                    break

        # Fill BR number on every page that has a BR widget,
        # then stamp as text overlay on pages without one.
        # brFields: optional explicit list of BR field name patterns.
        #   - If provided (list): use ONLY these patterns (e.g. ['fill_1_P.{pn}']).
        #     Pass [] to disable widget-based BR filling entirely (text overlay only).
        #   - If omitted/None: use default heuristics ['fill_1_P.{pn}', 'fill_4_P.{pn}'].
        if br_number:
            br8 = re.sub(r'[^0-9A-Za-z]', '', br_number)[:8]
            br_fields_param = data.get('brFields', None)  # None = use defaults
            # Collect field names already explicitly filled (don't overwrite them)
            _filled_names = set(fields.keys())
            if br_fields_param is None:
                # Default: try common BR field name patterns on each page
                _br_patterns = [f'fill_1_P.{{pn}}', f'fill_4_P.{{pn}}']
                for pi in range(doc.page_count):
                    pn = pi + 1
                    br_filled = False
                    for br_field_tpl in _br_patterns:
                        br_field = br_field_tpl.format(pn=pn)
                        if br_field in _filled_names:
                            continue
                        if br_field in fmap:
                            for w in doc[pi].widgets():
                                if w.field_name == br_field:
                                    try:
                                        w.field_value = br8
                                        w.update()
                                        br_filled = True
                                    except Exception:
                                        pass
                                    break
                        if br_filled:
                            break
            elif br_fields_param:
                # Explicit BR field list — only fill these exact field names
                for br_field in br_fields_param:
                    if br_field in _filled_names:
                        continue
                    if br_field in fmap:
                        pi = fmap[br_field]
                        for w in doc[pi].widgets():
                            if w.field_name == br_field:
                                try:
                                    w.field_value = br8
                                    w.update()
                                except Exception:
                                    pass
                                break
            # else: br_fields_param is empty list → skip widget BR filling entirely
            # Always stamp text overlay as fallback (on all pages except those
            # that already have a widget BR filled). _stamp_br_on_all_pages
            # handles this by checking if the page has a BR widget.
            _stamp_br_on_all_pages(doc, br8)

        pdf_bytes = doc.write(deflate=True)
        doc.close()

        if unmatched_fields or unmatched_checkboxes:
            print(f"[TEMPLATE:{safe_name}] WARNING — unmatched fields: {unmatched_fields}, checkboxes: {unmatched_checkboxes}")

        import base64 as b64
        return jsonify({
            'pdf': b64.b64encode(pdf_bytes).decode('ascii'),
            'warnings': {
                'unmatched_fields': unmatched_fields,
                'unmatched_checkboxes': unmatched_checkboxes,
            } if (unmatched_fields or unmatched_checkboxes) else None,
        })
    except Exception as e:
        import traceback
        traceback.print_exc()
        return jsonify({'error': str(e)}), 500


# ─── Resolution AI 生成（DeepSeek） ───

@app.route('/api/generate-resolution', methods=['POST'])
def generate_resolution():
    try:
        data = request.json
        if not data:
            return jsonify({'error': 'Empty request body'}), 400
        if not data.get('companyName') or not data.get('resolutionType'):
            return jsonify({'error': 'companyName and resolutionType required'}), 400

        lang = data.get('language', 'bilingual')
        lang_instruction = (
            "Output in Traditional Chinese only."
            if lang == 'zh' else
            "Output in English only."
            if lang == 'en' else
            "Output bilingually: each major paragraph in English, followed by Traditional Chinese on a new line."
        )

        system_prompt = f"""You are a Hong Kong corporate secretarial assistant. Generate a formal company resolution.
Follow Hong Kong Companies Ordinance conventions. Use the WRITTEN RESOLUTION format unless the user asks for a meeting minute.
Structure:
1. Header: company name + Chinese name + BR number + "Written Resolution of Directors / Members"
2. Resolution number (e.g. "RESOLVED THAT:")
3. Body — clear, formal, numbered if multiple items
4. Effective date
5. Signature block (Director(s) / Members)
{lang_instruction}
Return ONLY the resolution body text, no markdown headers, no commentary, ready to paste into a PDF."""

        user_prompt = f"""Generate a {data['resolutionType']} resolution for:
Company: {data.get('companyName', '')}{' (' + data.get('companyChineseName', '') + ')' if data.get('companyChineseName') else ''}
BR Number: {data.get('brNumber', '—')}
Resolution Date: {data.get('resolutionDate', '')}

Context / Specific details from user:
{data.get('context', '(no extra context provided)')}"""

        api_key = os.environ.get('DEEPSEEK_API_KEY', '')
        if not api_key:
            return jsonify({'error': 'DEEPSEEK_API_KEY not configured'}), 500

        req_body = json.dumps({
            'model': 'deepseek-chat',
            'messages': [
                {'role': 'system', 'content': system_prompt},
                {'role': 'user', 'content': user_prompt},
            ],
        }).encode('utf-8')

        ai_req = urllib.request.Request(
            'https://api.deepseek.com/v1/chat/completions',
            data=req_body,
            headers={
                'Authorization': f'Bearer {api_key}',
                'Content-Type': 'application/json',
            }
        )
        ai_resp = urllib.request.urlopen(ai_req, timeout=120)
        result = json.loads(ai_resp.read())
        content = result.get('choices', [{}])[0].get('message', {}).get('content', '')

        return jsonify({'content': content})
    except urllib.error.HTTPError as e:
        return jsonify({'error': f'AI API error {e.code}: {e.reason}'}), 502
    except Exception as e:
        import traceback
        traceback.print_exc()
        return jsonify({'error': str(e)}), 500


# ─── DOCX Document Generation (功能說明書 7.1) ───
# Generate Microsoft Word (.docx) company secretarial documents from system data.

